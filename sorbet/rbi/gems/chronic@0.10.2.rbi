# A Span represents a range of time. Since this class extends
# Range, you can use #begin and #end to get the beginning and
# ending times of the span (they will be of class Time)
#
# pkg:gem/chronic#lib/chronic/span.rb:5
class Chronic::Span < ::Range
  # Add a number of seconds to this span, returning the
  # resulting Span
  #
  # pkg:gem/chronic#lib/chronic/span.rb:13
  def +(seconds); end

  # Subtract a number of seconds to this span, returning the
  # resulting Span
  #
  # pkg:gem/chronic#lib/chronic/span.rb:19
  def -(seconds); end

  # Prints this span in a nice fashion
  #
  # pkg:gem/chronic#lib/chronic/span.rb:24
  def to_s; end

  # Returns the width of this span in seconds
  #
  # pkg:gem/chronic#lib/chronic/span.rb:7
  def width; end
end

# Tokens are tagged with subclassed instances of this class when
# they match specific criteria.
#
# pkg:gem/chronic#lib/chronic/tag.rb:4
class Chronic::Tag
  # type - The Symbol type of this tag.
  #
  # pkg:gem/chronic#lib/chronic/tag.rb:9
  def initialize(type, options = T.unsafe(nil)); end

  # time - Set the start Time for this Tag.
  #
  # pkg:gem/chronic#lib/chronic/tag.rb:15
  def start=(time); end

  # pkg:gem/chronic#lib/chronic/tag.rb:6
  def type; end

  # pkg:gem/chronic#lib/chronic/tag.rb:6
  def type=(_arg0); end

  class << self
    private

    # pkg:gem/chronic#lib/chronic/tag.rb:22
    def scan_for(token, klass, items = T.unsafe(nil), options = T.unsafe(nil)); end
  end
end

# pkg:gem/chronic#lib/chronic/time.rb:2
class Chronic::Time
  class << self
    # Checks if given number could be hour
