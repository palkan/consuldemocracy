# = HTTPI::Cookie
#
# Represents a single delicious cookie.
#
# == Examples
#
#   cookie = HTTPI::Cookie.new("token=choc-choc-chip; Path=/; HttpOnly")
#
#   cookie.name            # "token"
#   cookie.name_and_value  # "token=choc-choc-chip"
#
# pkg:gem/httpi#lib/httpi/cookie.rb:13
class HTTPI::Cookie
  # pkg:gem/httpi#lib/httpi/cookie.rb:20
  def initialize(cookie); end

  # Returns the name of the cookie.
  #
  # pkg:gem/httpi#lib/httpi/cookie.rb:25
  def name; end

  # Returns the name and value of the cookie.
  #
  # pkg:gem/httpi#lib/httpi/cookie.rb:30
  def name_and_value; end

  class << self
    # Returns a list of cookies from a Hash of +headers+.
    #
    # pkg:gem/httpi#lib/httpi/cookie.rb:16
    def list_from_headers(headers); end
  end
end

# = HTTPI::CookieStore
#
# Stores a unique list of cookies for future requests.
#
# == Examples
#
#   # Add one or more cookies to the store
#   cookie_store = HTTPI::CookieStore.new
#   cookie_store.add HTTPI::Cookie.new("token=choc-choc-chip; Path=/; HttpOnly")
#
#   # Fetch the names and values for the "Cookie" header
#   cookie_store.fetch  # => "token=choc-choc-chip"
#
# pkg:gem/httpi#lib/httpi/cookie_store.rb:15
class HTTPI::CookieStore
  # pkg:gem/httpi#lib/httpi/cookie_store.rb:17
  def initialize; end

  # Adds one or more cookies to the store.
  #
  # pkg:gem/httpi#lib/httpi/cookie_store.rb:22
  def add(*cookies); end

  # Returns the names and values for the "Cookie" header.
  #
  # pkg:gem/httpi#lib/httpi/cookie_store.rb:29
  def fetch; end
end

