    def validate(config); end

    private

    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/config/validator.rb:79
    def ignored_environment?(config); end

    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/config/validator.rb:75
    def valid_environment?(config); end

    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/config/validator.rb:62
    def valid_project_id?(config); end

    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/config/validator.rb:68
    def valid_project_key?(config); end
  end
end

