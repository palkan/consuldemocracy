# pkg:gem/airbrake-ruby#lib/airbrake-ruby/file_cache.rb:6
module Airbrake::FileCache
  class << self
    # Retrieve an object from the cache.
    #
    # @param [Object] key
    # @return [Object] the corresponding value
    #
    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/file_cache.rb:30
    def [](key); end

    # Associates the value given by +value+ with the key given by +key+. Deletes
    # entries that exceed +MAX_SIZE+.
    #
    # @param [Object] key
    # @param [Object] value
    # @return [Object] the corresponding value
    #
    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/file_cache.rb:19
    def []=(key, value); end

    # Checks whether the cache is empty. Needed only for the test suite.
    #
    # @return [Boolean]
    #
    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/file_cache.rb:39
    def empty?; end

    # @since v4.7.0
    # @return [void]
    #
    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/file_cache.rb:45
    def reset; end

    private

    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/file_cache.rb:49
    def data; end
  end
end

