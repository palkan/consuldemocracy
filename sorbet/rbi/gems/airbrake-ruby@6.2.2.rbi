  def as_bytes; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/tdigest.rb:99
  def as_json(_ = T.unsafe(nil)); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/tdigest.rb:70
  def as_small_bytes; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/tdigest.rb:103
  def bound_mean(x); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/tdigest.rb:109
  def bound_mean_cumn(cumn); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/tdigest.rb:40
  def centroids; end

