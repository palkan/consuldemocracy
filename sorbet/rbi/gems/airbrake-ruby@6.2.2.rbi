# Stat is a data structure that allows accumulating performance data (route
# performance, SQL query performance and such). It's powered by TDigests.
#
# Usually, one Stat corresponds to one metric (route or query,
# etc.). Incrementing a stat means pushing new performance statistics.
#
# @example
#   stat = Airbrake::Stat.new
#   stat.increment_ms(2000)
#   stat.to_h # Pack and serialize data so it can be transmitted.
#
# @since v3.2.0
#
# pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:16
class Airbrake::Stat
  # @param [Float] sum The sum of duration in milliseconds
  # @param [Float] sumsq The squared sum of duration in milliseconds
  # @param [TDigest::TDigest] tdigest Packed durations. By default,
  #   compression is 20
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:23
  def initialize(sum: T.unsafe(nil), sumsq: T.unsafe(nil), tdigest: T.unsafe(nil)); end

  # Increments tdigest timings and updates tdigest with given +ms+ value.
  #
  # @param [Float] ms
  # @return [void]
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:48
  def increment_ms(ms); end

  # We define custom inspect so that we weed out uninformative TDigest, which
  # is also very slow to dump when we log Airbrake::Stat.
  #
  # @return [String]
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:61
  def inspect; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:64
  def pretty_print; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:17
  def sum; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:17
  def sum=(_arg0); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:17
  def sumsq; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:17
  def sumsq=(_arg0); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:17
  def tdigest; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:17
  def tdigest=(_arg0); end

  # @return [Hash{String=>Object}] stats as a hash with compressed TDigest
  #   (serialized as base64)
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/stat.rb:32
  def to_h; end
end

