# A default Airbrake notice filter. Filters everything in the payload of a
# notice, but specified keys.
#
# @example
#   filter = Airbrake::Filters::KeysAllowlist.new(
#     [:email, /credit/i, 'password']
#   )
#   airbrake.add_filter(filter)
#   airbrake.notify(StandardError.new('App crashed!'), {
#     user: 'John',
#     password: 's3kr3t',
#     email: 'john@example.com',
#     account_id: 42
#   })
#
#   # The dashboard will display this parameters as filtered, but other
#   # values won't be affected:
#   #   { user: 'John',
#   #     password: '[Filtered]',
#   #     email: 'john@example.com',
#   #     account_id: 42 }
#
# @see KeysBlocklist
# @see KeysFilter
#
# pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_allowlist.rb:27
class Airbrake::Filters::KeysAllowlist
  include ::Airbrake::Loggable
  include ::Airbrake::Filters::KeysFilter

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_allowlist.rb:30
  def initialize(*); end

  # @return [Boolean] true if the key doesn't match any pattern, false
  #   otherwise.
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_allowlist.rb:37
  def should_filter?(key); end
end

# A default Airbrake notice filter. Filters only specific keys listed in the
# list of parameters in the payload of a notice.
#
# @example
#   filter = Airbrake::Filters::KeysBlocklist.new(
#     [:email, /credit/i, 'password']
#   )
#   airbrake.add_filter(filter)
#   airbrake.notify(StandardError.new('App crashed!'), {
#     user: 'John'
#     password: 's3kr3t',
#     email: 'john@example.com',
#     credit_card: '5555555555554444'
#   })
#
#   # The dashboard will display this parameter as is, but all other
#   # values will be filtered:
#   #   { user: 'John',
#   #     password: '[Filtered]',
#   #     email: '[Filtered]',
#   #     credit_card: '[Filtered]' }
#
# @see KeysAllowlist
# @see KeysFilter
# @api private
#
# pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_blocklist.rb:28
class Airbrake::Filters::KeysBlocklist
  include ::Airbrake::Loggable
  include ::Airbrake::Filters::KeysFilter

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_blocklist.rb:31
  def initialize(*); end

  # @return [Boolean] true if the key matches at least one pattern, false
  #   otherwise
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_blocklist.rb:38
  def should_filter?(key); end
end

# This is a filter helper that endows a class ability to filter notices'
# payload based on the return value of the +should_filter?+ method that a
# class that includes this module must implement.
#
# @see Notice
# @see KeysAllowlist
# @see KeysBlocklist
# @api private
#
# pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:13
module Airbrake::Filters::KeysFilter
  include ::Airbrake::Loggable

  # Creates a new KeysBlocklist or KeysAllowlist filter that uses the given
  # +patterns+ for filtering a notice's payload.
  #
  # @param [Array<String,Regexp,Symbol>] patterns
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:49
  def initialize(patterns); end

  # @!macro call_filter
  #   This is a mandatory method required by any filter integrated with
  #   FilterChain.
  #
  #   @param [Notice] notice the notice to be filtered
  #   @return [void]
  #   @see FilterChain
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:61
  def call(notice); end

  # @raise [NotImplementedError] if called directly
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:79
  def should_filter?(_key); end

  # @return [Integer]
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:43
  def weight; end

  private

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:125
  def eval_proc_patterns!; end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:148
  def filter_context_key(notice, key); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:85
  def filter_hash(hash); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:113
  def filter_url(notice); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:105
  def filter_url_params(url); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/filters/keys_filter.rb:135
  def validate_patterns; end
end

