# TimedTrace represents a chunk of code performance of which was measured and
# stored under a label. The chunk is called a "span".
#
# @example
#   timed_trace = TimedTrace.new
#   timed_trace.span('http request') do
#     http.get('example.com')
#   end
#   timed_trace.spans #=> { 'http request' => 0.123 }
#
# @api public
# @since v4.3.0
#
# pkg:gem/airbrake-ruby#lib/airbrake-ruby/timed_trace.rb:14
class Airbrake::TimedTrace
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/timed_trace.rb:21
  def initialize; end

  # @param [String] label
  # @return [Boolean]
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/timed_trace.rb:27
  def span(label); end

  # @return [Hash<String=>Float>]
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/timed_trace.rb:52
  def spans; end

  # @param [String] label
  # @return [Boolean]
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/timed_trace.rb:35
  def start_span(label); end

  # @param [String] label
  # @return [Boolean]
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/timed_trace.rb:44
  def stop_span(label); end

  class << self
    # @param [String] label
    # @return [Airbrake::TimedTrace]
    #
    # pkg:gem/airbrake-ruby#lib/airbrake-ruby/timed_trace.rb:17
    def span(label, &block); end
  end
end

# This class is responsible for truncation of too big objects. Mainly, you
# should use it for simple objects such as strings, hashes, & arrays.
#
# @api private
# @since v1.0.0
#
# pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:7
class Airbrake::Truncator
  # @param [Integer] max_size maximum size of hashes, arrays and strings
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:29
  def initialize(max_size); end

  # Reduces maximum allowed size of hashes, arrays, sets & strings by half.
  # @return [Integer] current +max_size+ value
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:50
  def reduce_max_size; end

  # Performs deep truncation of arrays, hashes, sets & strings. Uses a
  # placeholder for recursive objects (`[Circular]`).
  #
  # @param [Object] object The object to truncate
  # @param [Set] seen The cache that helps to detect recursion
  # @return [Object] truncated object
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:39
  def truncate(object, seen = T.unsafe(nil)); end

  private

  # Replaces invalid characters in a string with arbitrary encoding.
  #
  # @param [String] str The string to replace characters
  # @return [String] a UTF-8 encoded string
  # @see https://github.com/flori/json/commit/3e158410e81f94dbbc3da6b7b35f4f64983aa4e3
  #
  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:112
  def replace_invalid_characters(str); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:75
  def stringify_object(object); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:92
  def truncate_array(array, seen); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:81
