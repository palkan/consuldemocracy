  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:56
  def truncate_object(object, seen); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:96
  def truncate_set(set, seen); end

  # pkg:gem/airbrake-ruby#lib/airbrake-ruby/truncator.rb:68
  def truncate_string(str); end
end

