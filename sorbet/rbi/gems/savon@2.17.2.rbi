  def wsdl_request; end

  private

  # pkg:gem/savon#lib/savon/transport/httpi.rb:124
  def configure_auth(http_request); end

  # pkg:gem/savon#lib/savon/transport/httpi.rb:86
  def configure_http_request(http_request); end

  # pkg:gem/savon#lib/savon/transport/httpi.rb:94
  def configure_proxy(http_request); end

  # pkg:gem/savon#lib/savon/transport/httpi.rb:130
  def configure_redirect_handling(http_request); end

  # Configures SSL on the HTTPI::Request from all ssl globals.
  # SSL option reference: https://github.com/savonrb/httpi/blob/main/lib/httpi/auth/ssl.rb
  #
  # pkg:gem/savon#lib/savon/transport/httpi.rb:106
  def configure_ssl(http_request); end

  # pkg:gem/savon#lib/savon/transport/httpi.rb:98
  def configure_timeouts(http_request); end
end

# Shared logging behaviour for HTTP transports.
#
# Expects the including class to expose @globals (Savon::GlobalOptions)
# so that log level, filters, and pretty-print settings can be accessed.
#
# log_request and log_response are intentionally private so that each
# transport drives them from its own post method.
#
# pkg:gem/savon#lib/savon/transport/logging.rb:14
module Savon::Transport::Logging
  private

  # pkg:gem/savon#lib/savon/transport/logging.rb:55
  def body_to_log(body); end

  # pkg:gem/savon#lib/savon/transport/logging.rb:51
  def headers_to_log(headers); end

  # pkg:gem/savon#lib/savon/transport/logging.rb:17
  def log?; end

  # pkg:gem/savon#lib/savon/transport/logging.rb:21
  def log_headers?; end

  # Logs the outbound request at INFO (URL and optional headers)
  # and DEBUG (filtered/pretty-printed body).
  #
  # @param url     [String] the SOAP endpoint URL
  # @param headers [Hash]   request headers
  # @param body    [String] the serialized SOAP envelope
  #
  # pkg:gem/savon#lib/savon/transport/logging.rb:35
  def log_request(url, headers, body); end

  # Logs the inbound response at INFO (status line)
  # and DEBUG (headers and filtered/pretty-printed body).
  #
  # @param response [Transport::Response]
  #
  # pkg:gem/savon#lib/savon/transport/logging.rb:45
  def log_response(response); end

  # pkg:gem/savon#lib/savon/transport/logging.rb:25
  def logger; end
end

# Transport-agnostic HTTP response value object.
#
# Every transport produces a Transport::Response so that higher-level code
# never depends on transport-specific code. Immutable once constructed.
#
# The shape of #cookies is transport-specific: HTTPI responses expose an
# Array of HTTPI::Cookie, while Faraday responses expose a plain Hash so
# Faraday users do not depend on HTTPI types.
#
# pkg:gem/savon#lib/savon/transport/response.rb:13
class Savon::Transport::Response
  # @param code    [Integer] HTTP status code
  # @param headers [Hash]    response headers
  # @param body    [String]  response body
  # @param cookies [Object]  parsed cookies in a transport-specific shape
  #
  # pkg:gem/savon#lib/savon/transport/response.rb:18
  def initialize(code, headers, body, cookies: T.unsafe(nil)); end

  # Returns the response body string.
  #
  # pkg:gem/savon#lib/savon/transport/response.rb:32
  def body; end

  # Returns the HTTP status code.
  #
  # pkg:gem/savon#lib/savon/transport/response.rb:26
  def code; end

  # Returns the parsed cookies in a transport-specific shape.
  # See class-level docs.
  #
  # pkg:gem/savon#lib/savon/transport/response.rb:36
  def cookies; end

  # Returns true when the HTTP status code indicates an error (>= 300).
  #
  # pkg:gem/savon#lib/savon/transport/response.rb:39
  def error?; end

  # Returns the response headers hash.
  #
  # pkg:gem/savon#lib/savon/transport/response.rb:29
  def headers; end
end

