# pkg:gem/ckeditor#lib/ckeditor/utils/content_type_detector.rb:5
class Ckeditor::Utils::ContentTypeDetector
  # pkg:gem/ckeditor#lib/ckeditor/utils/content_type_detector.rb:9
  def initialize(file_path); end

  # content type detection strategy:
  #
  # 1. empty file: returns 'inode/x-empty'
  # 2. nonempty file: if the file is not empty then returns the content type using file command
  # 3. invalid file: file command raises error and returns 'application/octet-stream'
  #
  # pkg:gem/ckeditor#lib/ckeditor/utils/content_type_detector.rb:19
  def detect; end

  private

  # pkg:gem/ckeditor#lib/ckeditor/utils/content_type_detector.rb:30
  def content_type_from_file_command; end

  # pkg:gem/ckeditor#lib/ckeditor/utils/content_type_detector.rb:25
  def empty_file?; end
end

# pkg:gem/ckeditor#lib/ckeditor/utils/content_type_detector.rb:7
Ckeditor::Utils::ContentTypeDetector::DEFAULT_CONTENT_TYPE = T.let(T.unsafe(nil), String)

# pkg:gem/ckeditor#lib/ckeditor/utils/content_type_detector.rb:6
Ckeditor::Utils::ContentTypeDetector::EMPTY_CONTENT_TYPE = T.let(T.unsafe(nil), String)

