module DeviseSecurity; end

# pkg:gem/devise-security#lib/devise-security.rb:98
module DeviseSecurity::Controllers; end

# pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:5
module DeviseSecurity::Controllers::Helpers
  extend ::ActiveSupport::Concern

  mixes_in_class_methods ::DeviseSecurity::Controllers::Helpers::ClassMethods

  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:31
  def valid_captcha_if_defined?(captcha); end

  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:26
  def valid_captcha_or_security_question?(resource, params); end

  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:36
  def valid_security_question_answer?(resource, answer); end

  protected

  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:126
  def ignore_paranoid_verification_code?; end

  # allow to overwrite for some special handlings
  #
  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:122
  def ignore_password_expire?; end

  private

  # path for change password
  #
  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:105
  def change_password_required_path_for(resource_or_scope = T.unsafe(nil)); end

  # lookup if extra (paranoid) code verification is needed
  #
  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:75
  def handle_paranoid_verification; end

  # Called as a `before_action` on all actions on any controller that uses
  # this helper. If the user's session is marked as having an expired
  # password we double check in case it has been changed by another process,
  # then redirect to the password change url.
  #
  # @note `Warden::Manager.after_authentication` is run AFTER this method
  #
  # @note Once the warden session has `'password_expired'` set to `false`,
  #    it will **never** be checked again until the user re-logs in.
  #
  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:54
  def handle_password_change; end

  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:112
  def paranoid_verification_code_path_for(resource_or_scope = T.unsafe(nil)); end

  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:100
  def redirect_for_paranoid_verification(scope); end

  # redirect for password update with alert message
  #
  # pkg:gem/devise-security#lib/devise-security/controllers/helpers.rb:96
  def redirect_for_password_change(scope); end
end

