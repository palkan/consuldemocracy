# pkg:gem/i18n-tasks#lib/i18n/tasks/split_key.rb:5
module I18n::Tasks::SplitKey
  private

  # yield each key part
  # dots inside braces or parenthesis are not split on
  #
  # pkg:gem/i18n-tasks#lib/i18n/tasks/split_key.rb:38
  def key_parts(key, &block); end

  # pkg:gem/i18n-tasks#lib/i18n/tasks/split_key.rb:30
  def last_key_part(key); end

  # split a key by dots (.)
  # dots inside braces or parenthesis are not split on
  #
  # split_key 'a.b'      # => ['a', 'b']
  # split_key 'a.#{b.c}' # => ['a', '#{b.c}']
  # split_key 'a.b.c', 2 # => ['a', 'b.c']
  #
  # pkg:gem/i18n-tasks#lib/i18n/tasks/split_key.rb:14
  def split_key(key, max = T.unsafe(nil)); end

  class << self
    # yield each key part
    # dots inside braces or parenthesis are not split on
    #
    # pkg:gem/i18n-tasks#lib/i18n/tasks/split_key.rb:38
    def key_parts(key, &block); end

    # pkg:gem/i18n-tasks#lib/i18n/tasks/split_key.rb:30
    def last_key_part(key); end

    # split a key by dots (.)
    # dots inside braces or parenthesis are not split on
    #
    # split_key 'a.b'      # => ['a', 'b']
    # split_key 'a.#{b.c}' # => ['a', '#{b.c}']
    # split_key 'a.b.c', 2 # => ['a', 'b.c']
    #
    # pkg:gem/i18n-tasks#lib/i18n/tasks/split_key.rb:14
    def split_key(key, max = T.unsafe(nil)); end
  end
end

