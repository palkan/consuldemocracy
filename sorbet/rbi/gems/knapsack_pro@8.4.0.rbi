# pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:4
class KnapsackPro::TestFileFinder
  # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:46
  def initialize(test_file_pattern, test_file_list_enabled); end

  # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:51
  def call; end

  private

  # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:84
  def test_file_hash_for(test_file_path); end

  # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:61
