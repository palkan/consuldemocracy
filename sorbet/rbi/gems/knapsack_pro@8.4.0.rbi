  # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:63
  def test_files; end

  class << self
    # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:5
    def call(test_file_pattern, test_file_list_enabled: T.unsafe(nil)); end

    # Args:
    #   test_file_entities_to_run - it can be list of slow test files that you want to run
    # Return:
    #   subset of test_file_entities_to_run that are present on disk and it is subset of tests matching pattern KNAPSACK_PRO_TEST_FILE_PATTERN
    #   Thanks to that we can select only slow test files that are within list of test file pattern we want to run tests for
    #
    # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:29
    def select_test_files_that_can_be_run(adapter_class, test_file_entities_to_run); end

    # finds slow test files on disk based on ENV patterns
    # returns example: [{ 'path' => 'a_spec.rb' }]
    #
    # pkg:gem/knapsack_pro#lib/knapsack_pro/test_file_finder.rb:11
    def slow_test_files_by_pattern(adapter_class); end
  end
end

