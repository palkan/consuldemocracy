  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/dimension.rb:47
  def first_cell_reference; end

  # the last cell in the dimension
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/dimension.rb:53
  def last_cell_reference; end

  # the full reference for this dimension
  # @return [String]
  #
