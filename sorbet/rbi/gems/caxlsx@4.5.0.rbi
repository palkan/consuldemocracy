# The Line3DChart is a three dimensional line chart (who would have guessed?) that you can add to your worksheet.
# @example Creating a chart
#   # This example creates a line in a single sheet.
#   require "rubygems" # if that is your preferred way to manage gems!
#   require "axlsx"
#
#   p = Axlsx::Package.new
#   ws = p.workbook.add_worksheet
#   ws.add_row ["This is a chart with no data in the sheet"]
#
#   chart = ws.add_chart(Axlsx::Line3DChart, :start_at=> [0,1], :end_at=>[0,6], :t#itle=>"Most Popular Pets")
#   chart.add_series :data => [1, 9, 10], :labels => ["Slimy Reptiles", "Fuzzy Bunnies", "Rottweiler"]
#
# @see Worksheet#add_chart
# @see Worksheet#add_row
# @see Chart#add_series
# @see Series
# @see Package#serialize
#
# pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:22
class Axlsx::Line3DChart < ::Axlsx::LineChart
  # Creates a new line chart object
  # @option options [String] gap_depth
  # @see Chart
  # @see lineChart
  # @see View3D
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:43
  def initialize(frame, options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:26
  def gapDepth; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:55
  def gapDepth=(v); end

  # space between bar or column clusters, as a percentage of the bar or column width.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:25
  def gap_depth; end

  # @see gapDepth
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:51
  def gap_depth=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:36
  def serAxis; end

  # the category axis
  # @return [Axis]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:33
  def ser_axis; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:60
  def to_xml_string(str = T.unsafe(nil)); end
end

# validation regex for gap amount percent
#
# pkg:gem/caxlsx#lib/axlsx/drawing/line_3D_chart.rb:29
Axlsx::Line3DChart::GAP_AMOUNT_PERCENT = T.let(T.unsafe(nil), Regexp)

# The LineChart is a two dimensional line chart (who would have guessed?) that you can add to your worksheet.
# @example Creating a chart
#   # This example creates a line in a single sheet.
#   require "rubygems" # if that is your preferred way to manage gems!
#   require "axlsx"
#
#   p = Axlsx::Package.new
#   ws = p.workbook.add_worksheet
#   ws.add_row ["This is a chart with no data in the sheet"]
#
#   chart = ws.add_chart(Axlsx::LineChart, :start_at=> [0,1], :end_at=>[0,6], :title=>"Most Popular Pets")
#   chart.add_series :data => [1, 9, 10], :labels => ["Slimy Reptiles", "Fuzzy Bunnies", "Rottweiler"]
#
# @see Worksheet#add_chart
# @see Worksheet#add_row
# @see Chart#add_series
# @see Series
# @see Package#serialize
#
# pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:22
class Axlsx::LineChart < ::Axlsx::Chart
  # Creates a new line chart object
  # @param [GraphicFrame] frame The workbook that owns this chart.
  # @option options [Cell, String] title
  # @option options [Boolean] show_legend
  # @option options [Symbol] grouping
  # @see Chart
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:47
  def initialize(frame, options = T.unsafe(nil)); end

  # The axes for this chart. LineCharts have a category and value
  # axis.
  # @return [Axes]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:94
  def axes; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:28
  def catAxis; end

  # the category axis
  # @return [CatAxis]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:25
  def cat_axis; end

  # must be one of  [:percentStacked, :clustered, :standard, :stacked]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:39
  def grouping; end

  # @see grouping
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:56
  def grouping=(v); end

  # The node name to use in serialization. As LineChart is used as the
  # base class for Liine3DChart we need to be sure to serialize the
  # chart based on the actual class type and not a fixed node name.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:65
  def node_name; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:77
  def to_xml_string(str = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:35
  def valAxis; end

  # the category axis
  # @return [ValAxis]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_chart.rb:32
  def val_axis; end
end

# A LineSeries defines the title, data and labels for line charts
# @note The recommended way to manage series is to use Chart#add_series
# @see Worksheet#add_chart
# @see Chart#add_series
#
# pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:8
class Axlsx::LineSeries < ::Axlsx::Series
  # Creates a new series
  # @option options [Array, SimpleTypedList] data
  # @option options [Array, SimpleTypedList] labels
  # @param [Chart] chart
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:38
  def initialize(chart, options = T.unsafe(nil)); end

  # The fill color for this series.
  # Red, green, and blue is expressed as sequence of hex digits, RRGGBB. A perceptual gamma of 2.2 is used.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:20
  def color; end

  # @see color
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:49
  def color=(v); end

  # The data for this series.
  # @return [ValAxisData]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:11
  def data; end

  # The labels for this series.
  # @return [CatAxisData]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:15
  def labels; end

  # custom marker symbol
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:28
  def marker_symbol; end

  # @see marker_symbol
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:60
  def marker_symbol=(v); end

  # show markers on values
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:24
  def show_marker; end

  # @see show_marker
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:54
  def show_marker=(v); end

  # line smoothing on values
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:32
  def smooth; end

  # @see smooth
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:66
  def smooth=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:74
  def to_xml_string(str = T.unsafe(nil)); end

  private

  # assigns the data for this series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:104
  def data=(v); end

  # assigns the labels for this series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/line_series.rb:110
  def labels=(v); end
end

# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:423
Axlsx::MAYBE_FLOAT_REGEX = T.let(T.unsafe(nil), Regexp)

# The Marker class defines a point in the worksheet that drawing anchors attach to.
# @note The recommended way to manage markers is Worksheet#add_chart Markers are created for a two cell anchor based on the :start and :end options.
# @see Worksheet#add_chart
#
# pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:7
class Axlsx::Marker
  include ::Axlsx::OptionsParser

  # Creates a new Marker object
  # @option options [Integer] col
  # @option options [Integer] colOff
  # @option options [Integer] row
  # @option options [Integer] rowOff
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:15
  def initialize(options = T.unsafe(nil)); end

  # The column this marker anchors to
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:22
  def col; end

  # @see col
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:37
  def col=(v); end

  # The offset distance from this marker's column
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:26
  def colOff; end

  # @see colOff
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:43
  def colOff=(v); end

  # shortcut to set the column, row position for this marker
  # @param col the column for the marker, a Cell object or a string reference like "B7"
  # or an Array.
  # @param row the row of the marker. This is ignored if the col parameter is a Cell or
  # String or Array.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:65
  def coord(col, row = T.unsafe(nil)); end

  # The row this marker anchors to
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:30
  def row; end

  # @see row
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:49
  def row=(v); end

  # The offset distance from this marker's row
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:34
  def rowOff; end

  # @see rowOff
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:55
  def rowOff=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:74
  def to_xml_string(str = T.unsafe(nil)); end

  private

  # handles multiple inputs for setting the position of a marker
  # @see Chart#start_at
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/marker.rb:84
  def parse_coord_args(x, y = T.unsafe(nil)); end
end

# A simple list of merged cells
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/merged_cells.rb:5
class Axlsx::MergedCells < ::Axlsx::SimpleTypedList
  # creates a new MergedCells object
