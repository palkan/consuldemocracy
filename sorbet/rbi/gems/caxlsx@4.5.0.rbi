# A BarSeries defines the title, data and labels for bar charts
# @note The recommended way to manage series is to use Chart#add_series
# @see Worksheet#add_chart
# @see Chart#add_series
#
# pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:8
class Axlsx::BarSeries < ::Axlsx::Series
  # Creates a new series
  # @option options [Array, SimpleTypedList] data
  # @option options [Array, SimpleTypedList] labels
  # @option options [String] title
  # @option options [String] shape
  # @option options [String] colors an array of colors to use when rendering each data point
  # @option options [String] series_color a color to use when rendering series
  # @param [Chart] chart
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:37
  def initialize(chart, options = T.unsafe(nil)); end

  # An array of rgb colors to apply to your bar chart.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:22
  def colors; end

  # @see colors
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:46
  def colors=(v); end

  # The data for this series.
  # @return [NumDataSource]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:11
  def data; end

  # The labels for this series.
  # @return [Array, SimpleTypedList]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:15
  def labels; end

  # The fill color for this series.
  # Red, green, and blue is expressed as sequence of hex digits, RRGGBB.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:27
  def series_color; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:51
  def series_color=(v); end

  # The shape of the bars or columns
  # @return [Symbol] must be one of [:cone, :coneToMax, :box, :cylinder, :pyramid, :pyramidToMax]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:19
  def shape; end

  # @see shape
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:56
  def shape=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:64
  def to_xml_string(str = T.unsafe(nil)); end

  private

  # assigns the data for this series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:91
  def data=(v); end

  # assigns the labels for this series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_series.rb:97
  def labels=(v); end
end

# This class details a border used in Office Open XML spreadsheet styles.
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:5
class Axlsx::Border
  include ::Axlsx::SerializedAttributes
  include ::Axlsx::OptionsParser
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new Border object
  # @option options [Boolean] diagonal_up
  # @option options [Boolean] diagonal_down
  # @option options [Boolean] outline
  # @example - Making a border
  #   p = Axlsx::Package.new
  #   red_border = p.workbook.styles.add_style :border => { :style => :thin, :color => "FFFF0000" }
  #   ws = p.workbook.add_worksheet
  #   ws.add_row [1,2,3], :style => red_border
  #   p.serialize('red_border.xlsx')
  #
  # @note The recommended way to manage borders is with Style#add_style
  # @see Style#add_style
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:24
  def initialize(options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:37
  def diagonalDown; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:57
  def diagonalDown=(v); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:33
  def diagonalUp; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:50
  def diagonalUp=(v); end

  # @return [Boolean] The diagonal down property for the border that indicates if the border should include a diagonal line from the top left to the top right of the cell.
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:36
  def diagonal_down; end

  # @see diagonalDown
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:53
  def diagonal_down=(v); end

  # @return [Boolean] The diagonal up property for the border that indicates if the border should include a diagonal line from the bottom left to the top right of the cell.
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:32
  def diagonal_up; end

  # @see diagonalUp
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:46
  def diagonal_up=(v); end

  # @return [Boolean] The outline property for the border indicating that top, left, right and bottom borders should only be applied to the outside border of a range of cells.
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:40
  def outline; end

  # @see outline
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:60
