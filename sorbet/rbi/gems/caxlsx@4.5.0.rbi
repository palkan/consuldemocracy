# The BufferedZipOutputStream buffers the output in order to avoid appending many small strings directly to the
# the `Zip::OutputStream`.
#
# The methods provided here mimic `Zip::OutputStream` so that this class can be used a drop-in replacement.
#
# pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:8
class Axlsx::BufferedZipOutputStream
  # pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:17
  def initialize(zos); end

  # pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:55
  def <<(content); end

  # pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:57
  def flush; end

  # Closes the current entry and opens a new for writing.
  #
  # pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:44
  def put_next_entry(entry); end

  # Write to a buffer that will be written to the current entry
  #
  # pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:50
  def write(content); end

  class << self
    # Create a temporary directory for writing files to.
    #
    # The directory and its contents are removed at the end of the block.
    #
    # pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:25
    def open(file_name, encrypter = T.unsafe(nil)); end

    # pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:34
    def write_buffer(io = T.unsafe(nil), encrypter = T.unsafe(nil)); end
  end
end

# The 4_096 was chosen somewhat arbitrary, however, it was difficult to see any obvious improvement with larger
# buffer sizes.
#
# pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:11
Axlsx::BufferedZipOutputStream::BUFFER_SIZE = T.let(T.unsafe(nil), Integer)

# The suppress_extra_fields method was introduced in rubyzip 3.2
# Between rubyzip 3.0 and 3.2, it automatically writes zip64 support to the xlsx files
# See: https://github.com/caxlsx/caxlsx/issues/481
#
# pkg:gem/caxlsx#lib/axlsx/util/buffered_zip_output_stream.rb:15
Axlsx::BufferedZipOutputStream::SUPPRESS_ZIP64 = T.let(T.unsafe(nil), Hash)

