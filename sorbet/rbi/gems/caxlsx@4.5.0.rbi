  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:90
  def to_xml_string(str = T.unsafe(nil)); end
end

# The order in which the child elements is put in the XML seems to
# be important for Excel
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:11
Axlsx::Dxf::CHILD_ELEMENTS = T.let(T.unsafe(nil), Array)

# XML Encoding
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:5
Axlsx::ENCODING = T.let(T.unsafe(nil), String)

# error message for invalid angles
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:326
Axlsx::ERR_ANGLE = T.let(T.unsafe(nil), String)

# error message for invalid cell reference
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:332
Axlsx::ERR_CELL_REFERENCE_INVALID = T.let(T.unsafe(nil), String)

# error message for cell reference with last cell missing
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:335
Axlsx::ERR_CELL_REFERENCE_MISSING_CELL = T.let(T.unsafe(nil), String)

# error message for duplicate sheet names
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:317
Axlsx::ERR_DUPLICATE_SHEET_NAME = T.let(T.unsafe(nil), String)

# error message for non 'integerish' value
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:329
Axlsx::ERR_INTEGERISH = T.let(T.unsafe(nil), String)

# error message for invalid border id reference
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:323
Axlsx::ERR_INVALID_BORDER_ID = T.let(T.unsafe(nil), String)

# error message when user does not provide color and or style options for border in Style#add_sytle
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:320
Axlsx::ERR_INVALID_BORDER_OPTIONS = T.let(T.unsafe(nil), String)

# error message for RangeValidator
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:305
Axlsx::ERR_RANGE = T.let(T.unsafe(nil), String)

# error message for RegexValidator
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:302
Axlsx::ERR_REGEX = T.let(T.unsafe(nil), String)

# error messages RestrictionValidor
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:296
Axlsx::ERR_RESTRICTION = T.let(T.unsafe(nil), String)

# error message for sheets that use a name which include invalid characters
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:314
Axlsx::ERR_SHEET_NAME_CHARACTER_FORBIDDEN = T.let(T.unsafe(nil), String)

# error message for sheets that use explicit empty string name
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:308
Axlsx::ERR_SHEET_NAME_EMPTY = T.let(T.unsafe(nil), String)

# error message for sheets that use a name which is longer than 31 bytes
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:311
Axlsx::ERR_SHEET_NAME_TOO_LONG = T.let(T.unsafe(nil), String)

# error message DataTypeValidator
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:299
Axlsx::ERR_TYPE = T.let(T.unsafe(nil), String)

# Leading characters that indicate a formula.
# See: https://owasp.org/www-community/attacks/CSV_Injection
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:430
Axlsx::FORMULA_PREFIX = T.let(T.unsafe(nil), String)

# The Fill is a formatting object that manages the background color, and pattern for cells.
# @note The recommended way to manage styles in your workbook is to use Styles#add_style.
# @see Styles#add_style
# @see PatternFill
# @see GradientFill
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/fill.rb:9
class Axlsx::Fill
  # Creates a new Fill object
  # @param [PatternFill, GradientFill] fill_type
  # @raise [ArgumentError] if the fill_type parameter is not a PatternFill or a GradientFill instance
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/fill.rb:17
  def initialize(fill_type); end

  # The type of fill
  # @return [PatternFill, GradientFill]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/fill.rb:12
  def fill_type; end

  # @see fill_type
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/fill.rb:31
  def fill_type=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/fill.rb:24
  def to_xml_string(str = T.unsafe(nil)); end
end

# The filterColumn collection identifies a particular column in the AutoFilter
# range and specifies filter information that has been applied to this column.
# If a column in the AutoFilter range has no criteria specified,
# then there is no corresponding filterColumn collection expressed for that column.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:8
class Axlsx::FilterColumn
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new FilterColumn object
  # @note This class yields its filter object as that is where the vast majority of processing will be done
  # @param [Integer|Cell] col_id The zero based index for the column to which this filter will be applied
  # @param [Symbol] filter_type The symbolized class name of the filter to apply to this column.
  # @param [Hash] options options for this object and the filter
  # @option [Boolean] hidden_button @see hidden_button
  # @option [Boolean] show_button @see show_button
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:19
  def initialize(col_id, filter_type, options = T.unsafe(nil)); end

  # Apply the filters for this column
  # @param [Array] row A row from a worksheet that needs to be
  # filtered.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:70
  def apply(row, offset); end

  # Zero-based index indicating the AutoFilter column to which this filter information applies.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:35
  def col_id; end

  # Sets the col_id attribute for this filter column.
  # @param [Integer | Cell] column_index The zero based index of the column to which this filter applies.
  #                         When you specify a cell, the column index will be read off the cell
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:61
  def col_id=(column_index); end

  # The actual filter being dealt with here
  # This could be any one of the allowed filter types
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:39
  def filter; end

  # Flag indicating whether the AutoFilter button for this column is hidden.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:53
  def hidden_button; end

  # @param [Boolean] hidden Flag indicating whether the AutoFilter button for this column is hidden.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:76
  def hidden_button=(hidden); end

  # Flag indicating whether the filter button is visible.
  # When the cell containing the filter button is merged with another cell,
  # the filter button can be hidden, and not drawn.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:45
  def show_button; end

  # Flag indicating whether the AutoFilter button is show. This is
  # undocumented in the spec, but exists in the schema file as an
  # optional attribute.
  # @param [Boolean] show Show or hide the button
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:86
  def show_button=(show); end

  # Serialize the object to xml
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:92
  def to_xml_string(str = T.unsafe(nil)); end
end

# Allowed filters
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filter_column.rb:31
Axlsx::FilterColumn::FILTERS = T.let(T.unsafe(nil), Array)

# When multiple values are chosen to filter by, or when a group of date values are chosen to filter by,
# this object groups those criteria together.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:6
class Axlsx::Filters
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new Filters object
  # @param [Hash] options Options used to set this objects attributes and
  #                       create filter and/or date group items
  # @option [Boolean] blank @see blank
  # @option [String] calendar_type @see calendar_type
  # @option [Array] filter_items An array of values that will be used to create filter objects.
  # @option [Array] date_group_items An array of hashes defining date group item filters to apply.
  # @note The recommended way to interact with filter objects is via AutoFilter#add_column
  # @example
  #   ws.auto_filter.add_column(0, :filters, :blank => true, :calendar_type => 'japan', :filter_items => [100, 'a'])
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:20
  def initialize(options = T.unsafe(nil)); end

  # Tells us if the row of the cell provided should be filtered as it
  # does not meet any of the specified filter_items or
  # date_group_items restrictions.
  # @param [Cell] cell The cell to test against items
  # TODO implement this for date filters as well!
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:44
  def apply(cell); end

  # Flag indicating whether to filter by blank.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:31
  def blank; end

  # Set the value for blank
  # @see blank
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:73
  def blank=(use_blank); end

  # Calendar type for date grouped items.
  # Used to interpret the values in dateGroupItem.
  # This is the calendar type used to evaluate all dates in the filter column,
  # even when those dates are not using the same calendar system / date formatting.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:37
  def calendar_type; end

  # @see calendar_type
  # @param [String] calendar The calendar type to use. This must be one of the types defined in CALENDAR_TYPES
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:66
  def calendar_type=(calendar); end

  # the date group values in this filters object
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:59
  def date_group_items; end

  # Date group items are date group filter items where you specify the
  # date_group and a value for that option as part of the auto_filter
  # @note This can be specified, but will not be applied to the date
  # values in your workbook at this time.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:102
  def date_group_items=(options); end

  # The filter values in this filters object
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:54
  def filter_items; end

  # not entirely happy with this.
  # filter_items should be a simple typed list that overrides << etc
  # to create Filter objects from the inserted values. However this
  # is most likely so rarely used...(really? do you know that?)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:92
  def filter_items=(values); end

  # Serialize the object to xml
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:79
  def to_xml_string(str = T.unsafe(nil)); end
end

# Allowed calendar types
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:27
Axlsx::Filters::CALENDAR_TYPES = T.let(T.unsafe(nil), Array)

# This collection is used to express a group of dates or times which are
# used in an AutoFilter criteria. Values are always written in the calendar
# type of the first date encountered in the filter range, so that all
# subsequent dates, even when formatted or represented by other calendar
# types, can be correctly compared for the purposes of filtering.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:135
class Axlsx::Filters::DateGroupItem
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new DateGroupItem
  # @param [Hash] options A hash of options to use when
  # instantiating the object
  # @option [String] date_time_grouping the part of the date this
  # filter should apply for grouping
  # @option [Integer|String] year @see year
  # @option [Integer] month @see month
  # @option [Integer] day @see day
  # @option [Integer] hour @see hour
  # @option [Integer] minute @see minute
  # @option [Integer] second @see second
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:150
  def initialize(options = T.unsafe(nil)); end

  # Grouping level
  # This must be one of year, month, day, hour, minute or second.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:165
  def date_time_grouping; end

  # The date time grouping for this filter.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:235
  def date_time_grouping=(grouping); end

  # Day (1-31)
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:177
  def day; end

  # The day value for the date group item
  # This must be between 1 and 31
  # @note no attempt is made to ensure the date value is valid for any given month
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:208
  def day=(value); end

  # Hour (0..23)
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:181
  def hour; end

  # The hour value for the date group item
  # # this must be between 0 and 23
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:215
  def hour=(value); end

  # Minute (0..59(
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:185
  def minute; end

  # The minute value for the date group item
  # This must be between 0 and 59
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:222
  def minute=(value); end

  # Month (1..12)
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:173
  def month; end

  # The month value for the date group item
  # This must be between 1 and 12
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:200
  def month=(value); end

  # Second (0..59)
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:189
  def second; end

  # The second value for the date group item
  # This must be between 0 and 59
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:229
  def second=(value); end

  # Serialize the object to xml
  # @param [String] str The string object this serialization will be concatenated to.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:242
  def to_xml_string(str = T.unsafe(nil)); end

  # Year (4 digits)
  # @return [Integer|String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:169
  def year; end

  # The year value for the date group item
  # This must be a four digit value
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:193
  def year=(value); end
end

# Allowed date time groupings
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:160
Axlsx::Filters::DateGroupItem::DATE_TIME_GROUPING = T.let(T.unsafe(nil), Array)

# This class expresses a filter criteria value.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:111
class Axlsx::Filters::Filter
  # Creates a new filter value object
  # @param [Any] value   The value of the filter. This is not restricted, but
  #                       will be serialized via to_s so if you are passing an object
  #                       be careful.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:116
  def initialize(value); end

  # Serializes the filter value object
  # @param [String] str The string to concact the serialization information to.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:125
  def to_xml_string(str = T.unsafe(nil)); end

  # Filter value used in the criteria.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:121
  def val; end

  # Filter value used in the criteria.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/filters.rb:121
  def val=(_arg0); end
end

# The Font class details a font instance for use in styling cells.
# @note The recommended way to manage fonts, and other styles is Styles#add_style
# @see Styles#add_style
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:7
class Axlsx::Font
  include ::Axlsx::OptionsParser

  # Creates a new Font
  # @option options [String] name
  # @option options [Integer] charset
  # @option options [Integer] family
  # @option options [Integer] family
  # @option options [Boolean] b
  # @option options [Boolean] i
  # @option options [Boolean] u
  # @option options [Boolean] strike
  # @option options [Boolean] outline
  # @option options [Boolean] shadow
  # @option options [Boolean] condense
  # @option options [Boolean] extend
  # @option options [Color] color
  # @option options [Integer] sz
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:25
  def initialize(options = T.unsafe(nil)); end

  # Indicates if the font should be rendered in *bold*
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:73
  def b; end

  # @see b
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:133
  def b=(v); end

  # The charset of the font
  # @return [Integer]
  # @note
  #  The following values are defined in the OOXML specification and are OS dependent values
  #   0   ANSI_CHARSET
  #   1   DEFAULT_CHARSET
  #   2   SYMBOL_CHARSET
  #   77  MAC_CHARSET
  #   128 SHIFTJIS_CHARSET
  #   129 HANGUL_CHARSET
  #   130 JOHAB_CHARSET
  #   134 GB2312_CHARSET
  #   136 CHINESEBIG5_CHARSET
  #   161 GREEK_CHARSET
  #   162 TURKISH_CHARSET
  #   163 VIETNAMESE_CHARSET
  #   177 HEBREW_CHARSET
  #   178 ARABIC_CHARSET
  #   186 BALTIC_CHARSET
  #   204 RUSSIAN_CHARSET
  #   222 THAI_CHARSET
  #   238 EASTEUROPE_CHARSET
  #   255 OEM_CHARSET
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:56
  def charset; end

  # @see charset
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:121
  def charset=(v); end

  # The color of the font
  # @return [Color]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:108
  def color; end

  # @see color
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:183
  def color=(v); end

  # Indicates if the font should be condensed
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:100
  def condense; end

  # @see condense
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:171
  def condense=(v); end

  # The font's extend property
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:104
  def extend; end

  # @see extend
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:177
  def extend=(v); end

  # The font's family
  # @note
  #  The following are defined OOXML specification
  #   0 Not applicable.
  #   1 Roman
  #   2 Swiss
  #   3 Modern
  #   4 Script
  #   5 Decorative
  #   6..14 Reserved for future use
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:69
  def family; end

  # @see family
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:127
  def family=(v); end

  # Indicates if the font should be rendered italicized
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:77
  def i; end

  # @see i
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:139
  def i=(v); end

  # The name of the font
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:31
  def name; end

  # @see name
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:115
  def name=(v); end

  # Indicates if the font should be rendered with an outline
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:92
  def outline; end

  # @see outline
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:159
  def outline=(v); end

  # Indicates if the font should be rendered with a shadow
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:96
  def shadow; end

  # @see shadow
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:165
  def shadow=(v); end

  # Indicates if the font should be rendered with a strikthrough
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:88
  def strike; end

  # @see strike
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:153
  def strike=(v); end

  # The size of the font.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:112
  def sz; end

  # @see sz
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:189
  def sz=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:197
  def to_xml_string(str = T.unsafe(nil)); end

  # Indicates if the font should be rendered underlined
  # It must be one of :none, :single, :double, :singleAccounting, :doubleAccounting, true, false
  # @return [String]
  # @note
  #  true or false is for backwards compatibility and is reassigned to :single or :none respectively
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:84
  def u; end

  # @see u
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/font.rb:145
  def u=(v); end
end

# gif content type
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:164
