# A ScatterSeries defines the x and y position of data in the chart
# @note The recommended way to manage series is to use Chart#add_series
# @see Worksheet#add_chart
# @see Chart#add_series
# @see examples/example.rb
#
# pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:9
class Axlsx::ScatterSeries < ::Axlsx::Series
  # Creates a new ScatterSeries
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:39
  def initialize(chart, options = T.unsafe(nil)); end

  # The fill color for this series.
  # Red, green, and blue is expressed as sequence of hex digits, RRGGBB. A perceptual gamma of 2.2 is used.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:21
  def color; end

  # @see color
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:59
  def color=(v); end

  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:24
  def ln_width; end

  # @see ln_width
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:70
  def ln_width=(v); end

  # custom marker symbol
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:36
  def marker_symbol; end

  # @see marker_symbol
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:75
  def marker_symbol=(v); end

  # Line markers presence
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:32
  def show_marker; end

  # Line smoothing between data points
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:28
  def smooth; end

  # @see smooth
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:64
  def smooth=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:83
  def to_xml_string(str = T.unsafe(nil)); end

  # The x data for this series.
  # @return [NamedAxisData]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:12
  def xData; end

  # The y data for this series.
  # @return [NamedAxisData]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:16
  def yData; end

  private

  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_series.rb:120
  def marker_symbol_xml; end
end

# Selection options for worksheet panes.
#
# @note The recommended way to manage the selection pane options is via SheetView#add_selection
# @see SheetView#add_selection
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:8
class Axlsx::Selection
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new {Selection} object
  # @option options [Cell, String] active_cell Active Cell Location
  # @option options [Integer] active_cell_id Active Cell Index
  # @option options [Symbol] pane Pane
  # @option options [String] sqref Sequence of References
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:17
  def initialize(options = T.unsafe(nil)); end

  # Active Cell Location
  # Location of the active cell.
  # @see type
  # @return [String]
  # default nil
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:28
  def active_cell; end

  # @see active_cell
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:76
  def active_cell=(v); end

  # Active Cell Index
  # 0-based index of the range reference (in the array of references listed in sqref)
  # containing the active cell. Only used when the selection in sqref is not contiguous.
  # Therefore, this value needs to be aware of the order in which the range references are
  # written in sqref.
  # When this value is out of range then activeCell can be used.
  # @see type
  # @return [Integer]
  # default nil
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:39
  def active_cell_id; end

  # @see active_cell_id
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:83
  def active_cell_id=(v); end

  # Pane
  # The pane to which this selection belongs.
  # Options are
  #  * bottom_left:  Bottom left pane, when both vertical and horizontal
  #                  splits are applied. This value is also used when only
  #                  a horizontal split has been applied, dividing the pane
  #                  into upper and lower regions. In that case, this value
  #                  specifies the bottom pane.
  #  * bottom_right: Bottom right pane, when both vertical and horizontal
  #                  splits are applied.
  #  * top_left:     Top left pane, when both vertical and horizontal splits
  #                  are applied. This value is also used when only a horizontal
  #                  split has been applied, dividing the pane into upper and lower
  #                  regions. In that case, this value specifies the top pane.
  #                  This value is also used when only a vertical split has
  #                  been applied, dividing the pane into right and left
  #                  regions. In that case, this value specifies the left pane
  #  * top_right:    Top right pane, when both vertical and horizontal
  #                  splits are applied. This value is also used when only
  #                  a vertical split has been applied, dividing the pane
  #                  into right and left regions. In that case, this value
  #                  specifies the right pane.
  # @see type
  # @return [Symbol]
  # default nil
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:66
  def pane; end

  # @see pane
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:89
  def pane=(v); end

  # Sequence of References
  # Range of the selection. Can be non-contiguous set of ranges.
  # @see type
  # @return [String]
  # default nil
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:73
  def sqref; end

  # @see sqref
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:95
  def sqref=(v); end

  # Serializes the data validation
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/selection.rb:103
  def to_xml_string(str = T.unsafe(nil)); end
end

