  def scatterStyle; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/scatter_chart.rb:47
  def scatterStyle=(v); end

  # The Style for the scatter chart
  # must be one of :none | :line | :lineMarker | :marker | :smooth | :smoothMarker
