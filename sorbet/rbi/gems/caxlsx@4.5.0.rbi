# Conditional formatting allows styling of ranges based on functions
#
# @note The recommended way to manage conditional formatting is via Worksheet#add_conditional_formatting
# @see Worksheet#add_conditional_formatting
# @see ConditionalFormattingRule
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:9
class Axlsx::ConditionalFormatting
  include ::Axlsx::OptionsParser

  # Creates a new {ConditionalFormatting} object
  # @option options [Array] rules The rules to apply
  # @option options [String] sqref The range to apply the rules to
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:15
  def initialize(options = T.unsafe(nil)); end

  # Add a ConditionalFormattingRule. If a hash of options is passed
  # in create a rule on the fly.
  # @param [ConditionalFormattingRule|Hash] rule A rule to use, or the options necessary to create one.
  # @see ConditionalFormattingRule#initialize
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:55
  def add_rule(rule); end

  # Add Conditional Formatting Rules to this object. Rules can either
  # be already created {ConditionalFormattingRule} elements or
  # hashes of options for automatic creation.  If rules is a hash
  # instead of an array, assume only one rule being added.
  #
  # @example This would apply formatting "1" to cells > 20, and formatting "2" to cells < 1
  #        conditional_formatting.add_rules [
  #            { :type => :cellIs, :operator => :greaterThan, :formula => "20", :dxfId => 1, :priority=> 1 },
  #            { :type => :cellIs, :operator => :lessThan, :formula => "10", :dxfId => 2, :priority=> 2 } ]
  #
  # @param [Array|Hash] rules the rules to apply, can be just one in hash form
  # @see ConditionalFormattingRule#initialize
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:44
  def add_rules(rules); end

  # Rules to apply the formatting to. Can be either a hash of
  # options to create a {ConditionalFormattingRule}, an array of hashes
  # for multiple ConditionalFormattingRules, or an array of already
  # created ConditionalFormattingRules.
  # @see ConditionalFormattingRule#initialize
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:30
  def rules; end

  # @see rules
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:64
  def rules=(v); end

  # Range over which the formatting is applied, in "A1:B2" format
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:22
  def sqref; end

  # @see sqref
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:69
  def sqref=(v); end

  # Serializes the conditional formatting element
  # @example Conditional Formatting XML looks like:
  #    <conditionalFormatting sqref="E3:E9">
  #        <cfRule type="cellIs" dxfId="0" priority="1" operator="greaterThan">
  #             <formula>0.5</formula>
  #        </cfRule>
  #    </conditionalFormatting>
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting.rb:83
  def to_xml_string(str = T.unsafe(nil)); end
end

# Conditional formatting rules specify formulas whose evaluations
# format cells
#
# @note The recommended way to manage these rules is via Worksheet#add_conditional_formatting
# @see Worksheet#add_conditional_formatting
# @see ConditionalFormattingRule#initialize
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:10
class Axlsx::ConditionalFormattingRule
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new Conditional Formatting Rule object
  # @option options [Symbol] type The type of this formatting rule
  # @option options [Boolean] aboveAverage This is an aboveAverage rule
  # @option options [Boolean] bottom This is a bottom N rule.
  # @option options [Integer] dxfId The formatting id to apply to matches
  # @option options [Boolean] equalAverage Is the aboveAverage or belowAverage rule inclusive
  # @option options [Integer] priority The priority of the rule, 1 is highest
  # @option options [Symbol] operator Which operator to apply
  # @option options [String] text The value to apply a text operator against
  # @option options [Boolean] percent If a top/bottom N rule, evaluate as N% rather than N
  # @option options [Integer] rank If a top/bottom N rule, the value of N
  # @option options [Integer] stdDev The number of standard deviations above or below the average to match
  # @option options [Boolean] stopIfTrue Stop evaluating rules after this rule matches
  # @option options [Symbol]  timePeriod The time period in a date occurring... rule
  # @option options [String] formula The formula to match against in i.e. an equal rule. Use a [minimum, maximum] array for cellIs between/notBetween conditionals.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:29
  def initialize(options = T.unsafe(nil)); end

  # Above average rule
  # Indicates whether the rule is an "above average" rule. True
  # indicates 'above average'. This attribute is ignored if type is
  # not equal to aboveAverage.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:58
  def aboveAverage; end

  # @see aboveAverage
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:164
  def aboveAverage=(v); end

  # Bottom N rule
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:62
  def bottom; end

  # @see bottom
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:170
  def bottom=(v); end

  # colorScale (Color Scale)
  # The color scale to apply to this conditional formatting
  # @return [ColorScale]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:139
  def color_scale; end

  # @see color_scale
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:242
  def color_scale=(v); end

  # dataBar (Data Bar)
  # The data bar to apply to this conditional formatting
  # @return [DataBar]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:146
  def data_bar; end

  # @see data_bar
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:248
  def data_bar=(v); end

  # Differential Formatting Id
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:66
  def dxfId; end

  # @see dxfId
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:176
  def dxfId=(v); end

  # Equal Average
  # Flag indicating whether the 'aboveAverage' and 'belowAverage'
  # criteria is inclusive of the average itself, or exclusive of
  # that value.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:73
  def equalAverage; end

  # @see equalAverage
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:182
  def equalAverage=(v); end

  # Formula
  # The formula or value to match against (e.g. 5 with an operator of :greaterThan to specify cell_value > 5).
  # If the operator is :between or :notBetween, use an array to specify [minimum, maximum]
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:42
  def formula; end

  # @see formula
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:236
  def formula=(v); end

  # iconSet (Icon Set)
  # The icon set to apply to this conditional formatting
  # @return [IconSet]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:153
  def icon_set; end

  # @see icon_set
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:254
  def icon_set=(v); end

  # Operator
  # The operator in a "cell value is" conditional formatting
  # rule. This attribute is ignored if type is not equal to cellIs
  #
  # Operator must be one of lessThan, lessThanOrEqual, equal,
  # notEqual, greaterThanOrEqual, greaterThan, between, notBetween,
  # containsText, notContains, beginsWith, endsWith
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:83
  def operator; end

  # @see operator
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:194
  def operator=(v); end

  # percent (Top 10 Percent)
  # indicates whether a "top/bottom n" rule is a "top/bottom n
  # percent" rule. This attribute is ignored if type is not equal to
  # top10.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:104
  def percent; end

  # @see percent
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:206
  def percent=(v); end

  # Priority
  # The priority of this conditional formatting rule. This value is
  # used to determine which format should be evaluated and
  # rendered. Lower numeric values are higher priority than higher
  # numeric values, where '1' is the highest priority.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:91
  def priority; end

  # @see priority
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:188
  def priority=(v); end

  # rank (Rank)
  # The value of "n" in a "top/bottom n" conditional formatting
  # rule. This attribute is ignored if type is not equal to top10.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:110
  def rank; end

  # @see rank
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:212
  def rank=(v); end

  # stdDev (StdDev)
  # The number of standard deviations to include above or below the
  # average in the conditional formatting rule. This attribute is
  # ignored if type is not equal to aboveAverage. If a value is
  # present for stdDev and the rule type = aboveAverage, then this
  # rule is automatically an "above or below N standard deviations"
  # rule.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:120
  def stdDev; end

  # @see stdDev
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:218
  def stdDev=(v); end

  # stopIfTrue (Stop If True)
  # If this flag is '1', no rules with lower priority shall be
  # applied over this rule, when this rule evaluates to true.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:126
  def stopIfTrue; end

  # @see stopIfTrue
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:224
  def stopIfTrue=(v); end

  # Text
  # used in a "text contains" conditional formatting
  # rule.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:97
  def text; end

  # @see text
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:200
  def text=(v); end

  # timePeriod (Time Period)
  # The applicable time period in a "date occurring…" conditional
  # formatting rule. This attribute is ignored if type is not equal
  # to timePeriod.
  # Valid types are today, yesterday, tomorrow, last7Days,
  # thisMonth, lastMonth, nextMonth, thisWeek, lastWeek, nextWeek
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:134
  def timePeriod; end

  # @see timePeriod
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:230
  def timePeriod=(v); end

  # Serializes the conditional formatting rule
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:262
  def to_xml_string(str = T.unsafe(nil)); end

  # Type (ST_CfType)
  # options are expression, cellIs, colorScale, dataBar, iconSet,
  # top10, uniqueValues, duplicateValues, containsText,
  # notContainsText, beginsWith, endsWith, containsBlanks,
  # notContainsBlanks, containsErrors, notContainsErrors,
  # timePeriod, aboveAverage
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:51
  def type; end

  # @see type
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formatting_rule.rb:158
  def type=(v); end
end

# A simple, self serializing class for storing conditional formatting
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formattings.rb:5
class Axlsx::ConditionalFormattings < ::Axlsx::SimpleTypedList
  # creates a new Tables object
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formattings.rb:7
  def initialize(worksheet); end

  # serialize the conditional formatting
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formattings.rb:19
  def to_xml_string(str = T.unsafe(nil)); end

  # The worksheet that owns this collection of tables
  # @return [Worksheet]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/conditional_formattings.rb:16
  def worksheet; end
end

# ContentTypes used in the package. This is automatically managed by the package package.
