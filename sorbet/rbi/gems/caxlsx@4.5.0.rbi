# The AreaChart is a two dimensional line chart (who would have guessed?) that you can add to your worksheet.
# @example Creating a chart
#   # This example creates a line in a single sheet.
#   require "rubygems" # if that is your preferred way to manage gems!
#   require "axlsx"
#
#   p = Axlsx::Package.new
#   ws = p.workbook.add_worksheet
#   ws.add_row ["This is a chart with no data in the sheet"]
#
#   chart = ws.add_chart(Axlsx::AreaChart, :start_at=> [0,1], :end_at=>[0,6], :title=>"Most Popular Pets")
#   chart.add_series :data => [1, 9, 10], :labels => ["Slimy Reptiles", "Fuzzy Bunnies", "Rottweiler"]
#
# @see Worksheet#add_chart
# @see Worksheet#add_row
# @see Chart#add_series
# @see Series
# @see Package#serialize
#
# pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:22
class Axlsx::AreaChart < ::Axlsx::Chart
  # Creates a new line chart object
  # @param [GraphicFrame] frame The workbook that owns this chart.
  # @option options [Cell, String] title
  # @option options [Boolean] show_legend
  # @option options [Symbol] grouping
  # @see Chart
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:47
  def initialize(frame, options = T.unsafe(nil)); end

  # The axes for this chart. AreaCharts have a category and value
  # axis.
  # @return [Axes]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:94
  def axes; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:28
  def catAxis; end

  # the category axis
  # @return [CatAxis]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:25
  def cat_axis; end

  # must be one of  [:percentStacked, :clustered, :standard, :stacked]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:39
  def grouping; end

  # @see grouping
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:56
  def grouping=(v); end

  # The node name to use in serialization. As AreaChart is used as the
  # base class for Liine3DChart we need to be sure to serialize the
  # chart based on the actual class type and not a fixed node name.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:65
  def node_name; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:77
  def to_xml_string(str = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:35
  def valAxis; end

  # the category axis
  # @return [ValAxis]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_chart.rb:32
  def val_axis; end
end

# A AreaSeries defines the title, data and labels for line charts
# @note The recommended way to manage series is to use Chart#add_series
# @see Worksheet#add_chart
# @see Chart#add_series
#
# pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:8
class Axlsx::AreaSeries < ::Axlsx::Series
  # Creates a new series
  # @option options [Array, SimpleTypedList] data
  # @option options [Array, SimpleTypedList] labels
  # @param [Chart] chart
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:38
  def initialize(chart, options = T.unsafe(nil)); end

  # The fill color for this series.
  # Red, green, and blue is expressed as sequence of hex digits, RRGGBB. A perceptual gamma of 2.2 is used.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:20
  def color; end

  # @see color
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:49
  def color=(v); end

  # The data for this series.
  # @return [ValAxisData]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:11
  def data; end

  # The labels for this series.
  # @return [CatAxisData]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:15
  def labels; end

  # custom marker symbol
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:28
  def marker_symbol; end

  # @see marker_symbol
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:60
  def marker_symbol=(v); end

  # show markers on values
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:24
  def show_marker; end

  # @see show_marker
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:54
  def show_marker=(v); end

  # line smoothing on values
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:32
  def smooth; end

  # @see smooth
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:66
  def smooth=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:74
  def to_xml_string(str = T.unsafe(nil)); end

  private

  # assigns the data for this series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:104
  def data=(v); end

  # assigns the labels for this series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/area_series.rb:110
  def labels=(v); end
end

# This class represents an auto filter range in a worksheet
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:5
class Axlsx::AutoFilter
  # creates a new Autofilter object
  # @param [Worksheet] worksheet
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:8
  def initialize(worksheet); end

  # Adds a filter column. This is the recommended way to create and manage filter columns for your autofilter.
  # In addition to the require id and type parameters, options will be passed to the filter column during instantiation.
  # @param [String] col_id Zero-based index indicating the AutoFilter column to which this filter information applies.
  # @param [Symbol] filter_type A symbol representing one of the supported filter types.
  # @param [Hash] options a hash of options to pass into the generated filter
  # @return [FilterColumn]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:62
  def add_column(col_id, filter_type, options = T.unsafe(nil)); end

  # Performs the sorting of the rows based on the sort_state conditions. Then it actually performs
  # the filtering of rows who's cells do not match the filter.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:69
  def apply; end

  # A collection of filterColumns for this auto_filter
  # @return [SimpleTypedList]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:52
  def columns; end

  # the formula for the defined name required for this auto filter
  # This prepends the worksheet name to the absolute cell reference
  # e.g. A1:B2 -> 'Sheet1'!$A$1:$B$2
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:26
  def defined_name; end

  # The range the autofilter should be applied to.
  # This should be a string like 'A1:B8'
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:20
  def range; end

  # The range the autofilter should be applied to.
  # This should be a string like 'A1:B8'
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:20
  def range=(_arg0); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:15
  def sort_on_generate; end

  # @param [Boolean] v Flag indicating whether the AutoFilter should sort the rows when generating the
  # file. If false, the sorting rules will need to be applied manually after generating to alter
  # the order of the rows.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:131
  def sort_on_generate=(v); end

  # the SortState object for this AutoFilter
  # @return [SortState]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:123
  def sort_state; end

  # serialize the object
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:138
  def to_xml_string(str = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/auto_filter/auto_filter.rb:15
  def worksheet; end
end

# An axis data source that can contain referenced or literal strings or numbers
# @note only string data types are supported - mainly because we have not implemented a chart type that requires a numerical axis value
#
# pkg:gem/caxlsx#lib/axlsx/drawing/ax_data_source.rb:6
class Axlsx::AxDataSource < ::Axlsx::NumDataSource
  # creates a new NumDataSource object
  # @option options [Array] data An array of Cells or Numeric objects
  # @option options [Symbol] tag_name see tag_name
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/ax_data_source.rb:10
  def initialize(options = T.unsafe(nil)); end

  class << self
    # allowed element tag names for serialization
    # @return [Array]
    #
    # pkg:gem/caxlsx#lib/axlsx/drawing/ax_data_source.rb:19
    def allowed_tag_names; end
  end
end

# The Axes class creates and manages axis information and
# serialization for charts.
#
# pkg:gem/caxlsx#lib/axlsx/drawing/axes.rb:6
class Axlsx::Axes
  # @param [Hash] options options used to generate axis each key
  # should be an axis name like :val_axis and its value should be the
  # class of the axis type to construct. The :cat_axis, if there is one,
  # must come first (we assume a Ruby 1.9+ Hash or an OrderedHash).
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axes.rb:11
  def initialize(options = T.unsafe(nil)); end

  # [] provides associative access to a specific axis store in an axes
  # instance.
  # @return [Axis]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axes.rb:22
  def [](name); end

  # Adds an axis to the collection
  # @param [Symbol] name The name of the axis
  # @param [Axis] axis_class The axis class to generate
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axes.rb:45
  def add_axis(name, axis_class); end

  # Serializes the object
  # @param [String] str
  # @param [Hash] options
  # @option options ids
  # If the ids option is specified only the axis identifier is
  # serialized. Otherwise, each axis is serialized in full.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axes.rb:32
  def to_xml_string(str = T.unsafe(nil), options = T.unsafe(nil)); end

  private

  # pkg:gem/caxlsx#lib/axlsx/drawing/axes.rb:53
  def axes; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axes.rb:57
  def set_cross_axis(axis); end
end

# the access class defines common properties and values for a chart axis.
#
# pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:5
class Axlsx::Axis
  include ::Axlsx::OptionsParser

  # Creates an Axis object
  # @option options [Axis] cross_axis the perpendicular axis
  # @option options [Symbol] ax_pos
  # @option options [Symbol] crosses
  # @option options [Symbol] tick_lbl_pos
  # @raise [ArgumentError] If axi_id or cross_ax are not unsigned integers
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:14
  def initialize(options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:38
  def axID; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:54
  def axPos; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:120
  def axPos=(v); end

  # The position of the axis
  # must be one of [:l, :r, :t, :b]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:53
  def ax_pos; end

  # The position of the axis
  # must be one of [:l, :r, :t, :b]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:116
  def ax_pos=(v); end

  # the fill color to use in the axis shape properties. This should be a 6 character long hex string
  # e.g. FF0000 for red
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:33
  def color; end

  # The color for this axis. This value is used when rendering the axis line in the chart.
  # colors should be in 6 character rbg format
  # @return [String] the rbg color assigned.
  # @see color
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:103
  def color=(color_rgb); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:43
  def crossAx; end

  # The perpendicular axis
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:42
  def cross_axis; end

  # The crossing axis for this axis
  # @param [Axis] axis
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:109
  def cross_axis=(axis); end

  # specifies how the perpendicular axis is crossed
  # must be one of [:autoZero, :min, :max]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:82
  def crosses; end

  # specifies how the perpendicular axis is crossed
  # must be one of [:autoZero, :min, :max]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:171
  def crosses=(v); end

  # specifies if gridlines should be shown in the chart
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:94
  def delete; end

  # Specify if axis should be removed from the chart
  # default false
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:164
  def delete=(v); end

  # The number format format code for this axis
  # default :General
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:77
  def format_code; end

  # The number format format code for this axis
  # default :General
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:150
  def format_code=(v); end

  # specifies if gridlines should be shown in the chart
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:90
  def gridlines; end

  # Specify if gridlines should be shown for this axis
  # default true
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:157
  def gridlines=(v); end

  # the id of the axis.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:37
  def id; end

  # specifies how the degree of label rotation
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:86
  def label_rotation; end

  # Specify the degree of label rotation to apply to labels
  # default true
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:178
  def label_rotation=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:66
  def majorTickMark; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:138
  def majorTickMark=(v); end

  # the type of major tick mark
  # must be one of [:cross, :in, :none, :out]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:65
  def major_tick_mark; end

  # the type of major tick mark
  # must be one of [:cross, :in, :none, :out]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:134
  def major_tick_mark=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:72
  def minorTickMark; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:146
  def minorTickMark=(v); end

  # the type of minor tick mark
  # must be one of [:cross, :in, :none, :out]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:71
  def minor_tick_mark; end

  # the type of minor tick mark
  # must be one of [:cross, :in, :none, :out]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:142
  def minor_tick_mark=(v); end

  # The scaling of the axis
  # @see Scaling
  # @return [Scaling]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:48
  def scaling; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:60
  def tickLblPos; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:128
  def tickLblPos=(v); end

  # the position of the tick labels
  # must be one of [:nextTo, :high, :low]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:59
  def tick_lbl_pos; end

  # the position of the tick labels
  # must be one of [:nextTo, :high, :low1]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:124
  def tick_lbl_pos=(v); end

  # the title for the axis. This can be a cell or a fixed string.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:97
  def title; end

  # The title object for the chart.
  # @param [String, Cell] v
  # @return [Title]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:188
  def title=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:201
  def to_xml_string(str = T.unsafe(nil)); end
end

# pkg:gem/caxlsx#lib/axlsx/drawing/axis.rb:130
Axlsx::Axis::VALID_TICK_MARK_VALUES = T.let(T.unsafe(nil), Array)

# pkg:gem/caxlsx#lib/axlsx/util/validators.rb:111
Axlsx::BOOLEAN_VALIDATOR = T.let(T.unsafe(nil), Proc)

# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:438
Axlsx::BOOLEAN_VALUES = T.let(T.unsafe(nil), Array)

