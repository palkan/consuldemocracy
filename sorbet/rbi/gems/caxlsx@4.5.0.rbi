# 3D attributes for a chart.
#
# pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:5
class Axlsx::View3D
  include ::Axlsx::OptionsParser

  # Creates a new View3D for charts
  # @option options [Integer] rot_x
  # @option options [String] h_percent
  # @option options [Integer] rot_y
  # @option options [String] depth_percent
  # @option options [Boolean] r_ang_ax
  # @option options [Integer] perspective
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:15
  def initialize(options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:48
  def depthPercent; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:85
  def depthPercent=(v); end

  # depth or chart as % of chart width
  # must be between 20% and 2000%
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:47
  def depth_percent; end

  # @see depth_percent
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:81
  def depth_percent=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:36
  def hPercent; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:71
  def hPercent=(v); end

  # height of chart as % of chart width
  # must be between 5% and 500%
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:35
  def h_percent; end

  # @see h_percent
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:67
  def h_percent=(v); end

  # field of view angle
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:57
  def perspective; end

  # @see perspective
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:95
  def perspective=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:53
  def rAngAx; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:92
  def rAngAx=(v); end

  # Chart axis are at right angles
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:52
  def r_ang_ax; end

  # @see r_ang_ax
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:88
  def r_ang_ax=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:30
  def rotX; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:64
  def rotX=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:42
  def rotY; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:78
  def rotY=(v); end

  # x rotation for the chart
  # must be between -90 and 90
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:29
  def rot_x; end

  # @see rot_x
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:60
  def rot_x=(v); end

  # y rotation for the chart
  # must be between 0 and 360
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:41
  def rot_y; end

  # @see rot_y
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:74
  def rot_y=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:105
  def to_xml_string(str = T.unsafe(nil)); end

  private

  # NOTE: move this to Axlsx module if we find the same pattern elsewhere.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/view_3D.rb:116
  def element_for_attribute(name, namespace = T.unsafe(nil)); end
end

