  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:268
  def outline; end

  # @see outline
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:271
  def outline=(v); end

  # Indicates if the cell is good for shared string table
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:178
  def plain_string?; end

  # @return [Array] of x/y coordinates in the sheet for this cell.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:388
  def pos; end

  # @return [String] The alpha(column)numeric(row) reference for this sell.
