  # @see Dxf#alignment
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:52
  def alignment=(v); end

  # the border to be used in this style
  # @return [Border]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:38
  def border; end

  # @see border
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:76
  def border=(v); end

  # the child fill to be used in this style
  # @return [Fill]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:34
  def fill; end

  # @see fill
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:82
  def fill=(v); end

  # the child font to be used for this style
  # @return [Font]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:30
  def font; end

  # @see font
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:70
  def font=(v); end

  # the child NumFmt to be used to this style
  # @return [NumFmt]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:26
  def numFmt; end

  # @see numFmt
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/dxf.rb:64
  def numFmt=(v); end

  # The cell protection for this style
  # @return [CellProtection]
  # @see CellProtection
  #
