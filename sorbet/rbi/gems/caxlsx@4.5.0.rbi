# This module allows us to define a list of symbols defining which
# attributes will be serialized for a class.
#
# pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:6
module Axlsx::SerializedAttributes
  mixes_in_class_methods ::Axlsx::SerializedAttributes::ClassMethods

  # serializes the instance values of the defining object based on the
  # list of serializable attributes.
  # @param [String] str The string instance to append this
  # serialization to.
  # @param [Hash] additional_attributes An option key value hash for
  # defining values that are not serializable attributes list.
  # @param [Boolean] camelize_value Should the attribute values be camelized
  #
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:63
  def serialized_attributes(str = T.unsafe(nil), additional_attributes = T.unsafe(nil), camelize_value = T.unsafe(nil)); end

  # serialized instance values at text nodes on a camelized element of the
  # attribute name. You may pass in a block for evaluation against non nil
  # values. We use an array for element attributes because misordering will
  # break the xml.
  # @param [String] str The string instance to which serialized data is appended
  # @param [Array] additional_attributes An array of additional attribute names.
  # @return [String] The serialized output.
  #
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:99
  def serialized_element_attributes(str = T.unsafe(nil), additional_attributes = T.unsafe(nil)); end

  # creates a XML tag with serialized attributes
  # @see SerializedAttributes#serialized_attributes
  #
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:44
  def serialized_tag(tagname, str, additional_attributes = T.unsafe(nil)); end

  class << self
    # Extend with class methods
    #
    # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:8
    def included(base); end
  end
end

# class methods applied to all includers
#
# pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:13
module Axlsx::SerializedAttributes::ClassMethods
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:25
  def camel_xml_attributes; end

  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:29
  def ivar_xml_attributes; end

  # This is the method to be used in inheriting classes to specify
  # which of the instance values are serializable
  #
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:16
  def serializable_attributes(*symbols); end

  # This helper registers the attributes that will be formatted as elements.
  #
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:34
  def serializable_element_attributes(*symbols); end

  # a reader for those attributes
  #
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:23
  def xml_attributes; end

  # attr reader for element attributes
  #
  # pkg:gem/caxlsx#lib/axlsx/util/serialized_attributes.rb:39
  def xml_element_attributes; end
end

# A Series defines the common series attributes and is the super class for all concrete series types.
# @note The recommended way to manage series is to use Chart#add_series
# @see Worksheet#add_chart
# @see Chart#add_series
#
# pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:8
class Axlsx::Series
  include ::Axlsx::OptionsParser

  # Creates a new series
  # @param [Chart] chart
  # @option options [Integer] order
  # @option options [String] title
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:23
  def initialize(chart, options = T.unsafe(nil)); end

  # The chart that owns this series
  # @return [Chart]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:13
  def chart; end

  # The index of this series in the chart's series.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:32
  def index; end

  # The order of this series in the chart's series. By default the order is the index of the series.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:38
  def order; end

  # @see order
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:43
  def order=(v); end

  # The title of the series
  # @return [SeriesTitle]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:17
  def title; end

  # @see title
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:49
  def title=(v); end

  private

  # assigns the chart for this series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:58
  def chart=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series.rb:66
  def to_xml_string(str = T.unsafe(nil)); end
end

# A series title is a Title with a slightly different serialization than chart titles.
#
# pkg:gem/caxlsx#lib/axlsx/drawing/series_title.rb:5
class Axlsx::SeriesTitle < ::Axlsx::Title
  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/series_title.rb:9
  def to_xml_string(str = T.unsafe(nil)); end
