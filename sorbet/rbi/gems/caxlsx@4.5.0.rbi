  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:81
  def style; end

  # @return [Integer] The cellXfs item index applied to this cell.
  # @raise [ArgumentError] Invalid cellXfs id if the value provided is not within cellXfs items range.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:379
  def style=(v); end

  # Internal
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:86
  def style_str; end

  # The inline sz property for the cell
