    def get_mime_type_from_uri(v); end

    private

    # pkg:gem/caxlsx#lib/axlsx/util/mime_type_utils.rb:59
    def valid_image_file?(file_path, extension); end

    # pkg:gem/caxlsx#lib/axlsx/util/mime_type_utils.rb:55
