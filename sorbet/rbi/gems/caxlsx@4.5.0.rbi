# The Xf class defines a formatting record for use in Styles. The recommended way to manage styles for your workbook is with Styles#add_style
# @see Styles#add_style
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:6
class Axlsx::Xf
  include ::Axlsx::SerializedAttributes
  include ::Axlsx::OptionsParser
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new Xf object
  # @option options [Integer] numFmtId
  # @option options [Integer] fontId
  # @option options [Integer] fillId
  # @option options [Integer] borderId
  # @option options [Integer] xfId
  # @option options [Boolean] quotePrefix
  # @option options [Boolean] pivotButton
  # @option options [Boolean] applyNumberFormat
  # @option options [Boolean] applyFont
  # @option options [Boolean] applyFill
  # @option options [Boolean] applyBorder
  # @option options [Boolean] applyAlignment
  # @option options [Boolean] applyProtection
  # @option options [CellAlignment] alignment
  # @option options [CellProtection] protection
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:28
  def initialize(options = T.unsafe(nil)); end

  # The cell alignment for this style
  # @return [CellAlignment]
  # @see CellAlignment
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:39
  def alignment; end

  # @see Xf#alignment
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:99
  def alignment=(v); end

  # Indicates if the alignment options should be applied
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:92
  def applyAlignment; end

  # @see applyAlignment
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:177
  def applyAlignment=(v); end

  # indicates if the borderId should be applied
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:88
  def applyBorder; end

  # @see applyBorder
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:171
  def applyBorder=(v); end

  # indicates if the fillId should be applied
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:84
  def applyFill; end

  # @see applyFill
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:165
  def applyFill=(v); end

  # indicates if the fontId should be applied
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:80
  def applyFont; end

  # @see applyFont
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:159
  def applyFont=(v); end

  # indicates if the numFmtId should be applied
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:76
  def applyNumberFormat; end

  # @see applyNumberFormat
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:153
  def applyNumberFormat=(v); end

  # Indicates if the protection options should be applied
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:96
  def applyProtection; end

  # @see applyProtection
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:183
  def applyProtection=(v); end

  # index (0 based) of the border to be used in this style
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:60
  def borderId; end

  # @see borderId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:129
  def borderId=(v); end

  # index (0 based) of the fill to be used in this style
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:56
  def fillId; end

  # @see fillId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:123
  def fillId=(v); end

  # index (0 based) of the font to be used in this style
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:52
  def fontId; end

  # @see fontId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:117
  def fontId=(v); end

  # id of the numFmt to apply to this style
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:48
  def numFmtId; end

  # @see numFmtId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:111
  def numFmtId=(v); end

  # indicates if the cell has a pivot table drop down button
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:72
  def pivotButton; end

  # @see pivotButton
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:147
  def pivotButton=(v); end

  # The cell protection for this style
  # @return [CellProtection]
  # @see CellProtection
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:44
  def protection; end

  # @see protection
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:105
  def protection=(v); end

  # indicates if text should be prefixed by a single quote in the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:68
  def quotePrefix; end

  # @see quotePrefix
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:141
  def quotePrefix=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:191
  def to_xml_string(str = T.unsafe(nil)); end

  # index (0 based) of cellStylesXfs item to be used in this style. Only applies to cellXfs items
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:64
  def xfId; end

  # @see xfId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/xf.rb:135
  def xfId=(v); end
end

# The ZipCommand class supports zipping the Excel file contents using
# a binary zip program instead of RubyZip's `Zip::OutputStream`.
#
# The methods provided here mimic `Zip::OutputStream` so that `ZipCommand` can
# be used as a drop-in replacement. Note that method signatures are not
# identical to `Zip::OutputStream`, they are only sufficiently close so that
# `ZipCommand` and `Zip::OutputStream` can be interchangeably used within
# `caxlsx`.
#
# pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:15
class Axlsx::ZipCommand
  # pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:19
  def initialize(zip_command); end

  # pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:50
  def <<(content); end

  # Create a temporary directory for writing files to.
  #
  # The directory and its contents are removed at the end of the block.
  #
  # pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:28
  def open(output); end

  # Closes the current entry and opens a new for writing.
  #
  # pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:38
  def put_next_entry(entry); end

  # Write to a buffer that will be written to the current entry
  #
  # pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:47
  def write(content); end

  private

  # pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:54
  def write_file; end

  # pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:60
  def zip_parts(output); end
end

# Raised when the zip command exits with a non-zero status.
#
# pkg:gem/caxlsx#lib/axlsx/util/zip_command.rb:17
class Axlsx::ZipCommand::ZipError < ::StandardError; end
