# Package is responsible for managing all the bits and pieces that Open Office XML requires to make a valid
# xlsx document including validation and serialization.
#
# pkg:gem/caxlsx#lib/axlsx/package.rb:6
class Axlsx::Package
  include ::Axlsx::OptionsParser

  # Initializes your package
  #
  # @param [Hash] options A hash that you can use to specify the author and workbook for this package.
  # @option options [String] :author The author of the document
  # @option options [Time] :created_at Timestamp in the document properties (defaults to current time).
  # @option options [Boolean] :use_shared_strings This is passed to the workbook to specify that shared strings should be used when serializing the package.
  # @example Package.new :author => 'you!', :workbook => Workbook.new
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:24
  def initialize(options = T.unsafe(nil)); end

  # provides access to the app doc properties for this package
  # see App
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:11
  def app; end

  # provides access to the core doc properties for the package
  # see Core
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:15
  def core; end

  # Encrypt the package into a CFB using the password provided
  # This is not ready yet
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:174
  def encrypt(file_name, password); end

  # Serialize your workbook to disk as an xlsx document.
  #
  # @param [String] output The name of the file you want to serialize your package to
  # @param [Hash] options
  # @option options [Boolean] :confirm_valid Validate the package prior to serialization.
  # @option options [String] :zip_command When `nil`, `#serialize` with RubyZip to
  #   zip the XLSX file contents. When a String, the provided zip command (e.g.,
  #   "zip") is used to zip the file contents (may be faster for large files)
  # @option options [String] :password When specified, the serialized packaged will be
  #   encrypted with the password. Requires ooxml_crypt gem.
  # @return [Boolean] False if confirm_valid and validation errors exist. True if the package was serialized
  # @note A tremendous amount of effort has gone into ensuring that you cannot create invalid xlsx documents.
  #   options[:confirm_valid] should be used in the rare case that you cannot open the serialized file.
  # @see Package#validate
  # @example
  #   # This is how easy it is to create a valid xlsx file. Of course you might want to add a sheet or two, and maybe some data, styles and charts.
  #   # Take a look at the README for an example of how to do it!
  #
  #   #serialize to a file
  #   p = Axlsx::Package.new
  #   # ......add cool stuff to your workbook......
  #   p.serialize("example.xlsx")
  #
  #   # Serialize to a file, using a system zip binary
  #   p.serialize("example.xlsx", zip_command: "zip", confirm_valid: false)
  #   p.serialize("example.xlsx", zip_command: "/path/to/zip")
  #   p.serialize("example.xlsx", zip_command: "zip -1")
  #
  #   # Serialize to a stream
  #   s = p.to_stream()
  #   File.open('example_streamed.xlsx', 'wb') { |f| f.write(s.read) }
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:108
  def serialize(output, options = T.unsafe(nil), secondary_options = T.unsafe(nil)); end

  # Serialize your workbook to a StringIO instance
  # @param [Boolean] old_confirm_valid (Deprecated) Validate the package prior to serialization.
  #   Use :confirm_valid keyword arg instead.
  # @option kwargs [Boolean] :confirm_valid Validate the package prior to serialization.
  # @option kwargs [String] :password When specified, the serialized packaged will be
  #   encrypted with the password. Requires ooxml_crypt gem.
  # @return [StringIO|Boolean] False if confirm_valid and validation errors exist. Rewound string IO if not.
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:143
  def to_stream(old_confirm_valid = T.unsafe(nil), confirm_valid: T.unsafe(nil), password: T.unsafe(nil)); end

  # Shortcut to specify that the workbook should use autowidth
  # @see Workbook#use_autowidth
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:35
  def use_autowidth=(v); end

  # Shortcut to determine if the workbook is configured to use shared strings
  # @see Workbook#use_shared_strings
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:42
  def use_shared_strings; end

  # Shortcut to specify that the workbook should use shared strings
  # @see Workbook#use_shared_strings
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:48
  def use_shared_strings=(v); end

  # Validate all parts of the package against xsd schema.
  # @return [Array] An array of all validation errors found.
  # @note This gem includes all schema from OfficeOpenXML-XMLSchema-Transitional.zip and OpenPackagingConventions-XMLSchema.zip
  #   as per ECMA-376, Third edition. opc schema require an internet connection to import remote schema from dublin core for dc,
  #   dcterms and xml namespaces. Those remote schema are included in this gem, and the original files have been altered to
  #   refer to the local versions.
  #
  #   If by chance you are able to create a package that does not validate it indicates that the internal
  #   validation is not robust enough and needs to be improved. Please report your errors to the gem author.
  # @see https://www.ecma-international.org/publications-and-standards/standards/ecma-376/
  # @example
  #  # The following will output any error messages found in serialization.
  #  p = Axlsx::Package.new
  #  # ... code to create sheets, charts, styles etc.
  #  p.validate.each { |error| puts error.message }
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:195
  def validate; end

  # The workbook this package will serialize or validate.
  # @return [Workbook] If no workbook instance has been assigned with this package a new Workbook instance is returned.
  # @raise ArgumentError if workbook parameter is not a Workbook instance.
  # @note As there are multiple ways to instantiate a workbook for the package,
  #   here are a few examples:
  #     # assign directly during package instantiation
  #     wb = Package.new(:workbook => Workbook.new).workbook
  #
  #     # get a fresh workbook automatically from the package
  #     wb = Package.new().workbook
  #     #     # set the workbook after creating the package
  #     wb = Package.new().workbook = Workbook.new
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:65
  def workbook; end

  # @see workbook
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:72
  def workbook=(workbook); end

  private

  # Creates the minimum content types for generating a valid xlsx document.
  # @return [ContentType]
  # @private
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:378
  def base_content_types; end

  # Appends override objects for drawings, charts, and sheets as they exist in your workbook to the default content types.
  # @return [ContentType]
  # @private
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:318
  def content_types; end

  # Parse the arguments of `#serialize`
  # @return [Boolean, (String or nil), (String or nil)] Returns a 3-tuple where values are
  #   `confirm_valid`, `zip_command`, and `password`.
  # @private
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:407
  def parse_serialize_options(options, secondary_options); end

  # The parts of a package
  # @return [Array] An array of hashes that define the entry, document and schema for each part of the package.
  # @private
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:245
  def parts; end

  # Creates the relationships required for a valid xlsx document
  # @return [Relationships]
  # @private
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:394
  def relationships; end

  # pkg:gem/caxlsx#lib/axlsx/package.rb:427
  def require_ooxml_crypt!; end

  # Performs xsd validation for a single document
  #
  # @param [String] schema path to the xsd schema to be used in validation.
  # @param [String] doc The xml text to be validated
  # @return [Array] An array of all validation errors encountered.
  # @private
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:308
  def validate_single_doc(schema, doc); end

  # Writes the package parts to a zip archive.
  # @param [Zip::OutputStream, ZipCommand] zip
  # @return [Zip::OutputStream, ZipCommand]
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:210
  def write_parts(zip); end

  # Generate a Entry for the given package part.
  # The important part here is to explicitly set the timestamp for the zip entry: Serializing axlsx packages
  # with identical contents should result in identical zip files – however, the timestamp of a zip entry
  # defaults to the time of serialization and therefore the zip file contents would be different every time
  # the package is serialized.
  #
  # Note: {Core#created} also defaults to the current time – so to generate identical axlsx packages you have
  # to set this explicitly, too (eg. with `Package.new(created_at: Time.local(2013, 1, 1))`).
  #
  # @param part A hash describing a part of this package (see {#parts})
  # @return [Zip::Entry]
  #
  # pkg:gem/caxlsx#lib/axlsx/package.rb:236
  def zip_entry_for_part(part); end
end

# PageMargins specify the margins when printing a worksheet.
#
# For compatibility, PageMargins serialize to an empty string, unless at least one custom margin value
# has been specified. Otherwise, it serializes to a PageMargin element specifying all 6 margin values
# (using default values for margins that have not been specified explicitly).
#
# @note The recommended way to manage page margins is via Worksheet#page_margins
# @see Worksheet#page_margins
# @see Worksheet#initialize
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:13
class Axlsx::PageMargins
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new PageMargins object
  # @option options [Numeric] left The left margin in inches
  # @option options [Numeric] right The right margin in inches
  # @option options [Numeric] bottom The bottom margin in inches
  # @option options [Numeric] top The top margin in inches
  # @option options [Numeric] header The header margin in inches
  # @option options [Numeric] footer The footer margin in inches
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:24
  def initialize(options = T.unsafe(nil)); end

  # Bottom margin (in inches)
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:60
  def bottom; end

  # @see bottom
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:99
  def bottom=(v); end

  # Footer margin (in inches)
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:68
  def footer; end

  # @see footer
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:111
  def footer=(v); end

  # Header margin (in inches)
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:64
  def header; end

  # @see header
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:105
  def header=(v); end

  # Left margin (in inches)
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:48
  def left; end

  # @see left
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:81
  def left=(v); end

  # Right margin (in inches)
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:52
  def right; end

  # @see right
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:87
  def right=(v); end

  # Set some or all margins at once.
  # @param [Hash] margins the margins to set. See {MARGIN_KEYS} for a list of possible keys.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:72
  def set(margins); end

  # Serializes the page margins element
  # @param [String] str
  # @return [String]
  # @note For compatibility, this is a noop unless custom margins have been specified.
  # @see #custom_margins_specified?
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:121
  def to_xml_string(str = T.unsafe(nil)); end

  # Top margin (in inches)
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:56
  def top; end

  # @see top
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:93
  def top=(v); end
end

# Default header and footer margins (in inches)
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:44
Axlsx::PageMargins::DEFAULT_HEADER_FOOTER = T.let(T.unsafe(nil), Float)

# Default left and right margin (in inches)
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:38
Axlsx::PageMargins::DEFAULT_LEFT_RIGHT = T.let(T.unsafe(nil), Float)

# Default top and bottom margins (in inches)
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:41
Axlsx::PageMargins::DEFAULT_TOP_BOTTOM = T.let(T.unsafe(nil), Float)

# Possible margins to set
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_margins.rb:33
Axlsx::PageMargins::MARGIN_KEYS = T.let(T.unsafe(nil), Array)

# Page setup properties of the worksheet
# This class name is not a typo, its spec.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_set_up_pr.rb:6
class Axlsx::PageSetUpPr
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # creates a new page setup properties object
  # @param [Hash] options
  # @option [Boolean] auto_page_breaks Flag indicating whether the sheet displays Automatic Page Breaks.
  # @option [Boolean] fit_to_page Flag indicating whether the Fit to Page print option is enabled.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_set_up_pr.rb:14
  def initialize(options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_set_up_pr.rb:20
  def auto_page_breaks; end

  # Flag indicating whether the sheet displays Automatic Page Breaks.
  # @param [Boolean] value
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_set_up_pr.rb:33
  def auto_page_breaks=(value); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_set_up_pr.rb:20
  def fit_to_page; end

  # Flag indicating whether the Fit to Page print option is enabled.
  # @param [Boolean] value
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_set_up_pr.rb:25
  def fit_to_page=(value); end

  # serialize to xml
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_set_up_pr.rb:39
  def to_xml_string(str = T.unsafe(nil)); end
end

# Page setup settings for printing a worksheet. All settings are optional.
#
# @note The recommended way to manage print options is via Worksheet#page_setup
# @see Worksheet#print_options
# @see Worksheet#initialize
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:9
class Axlsx::PageSetup
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new PageSetup object
  # @option options [Integer] fit_to_height Number of vertical pages to fit on
  # @option options [Integer] fit_to_width Number of horizontal pages to fit on
  # @option options [Symbol] orientation Orientation of the page (:default, :landscape, :portrait)
  # @option options [String] paper_height Height of paper (number followed by unit identifier: "297mm", "11in")
  # @option options [String] paper_width Width of paper (number followed by unit identifier: "210mm", "8.5in")
  # @option options [Integer] scale Print scaling (percent value, integer ranging from 10 to 400)
  # @option options [Integer] paper_size - the size of paper to use
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:21
  def initialize(options = T.unsafe(nil)); end

  # convenience method to achieve sanity when setting fit_to_width and fit_to_height
  # as they both default to 1 if only their counterpart is specified.
  # @note This method will overwrite any value you explicitly set via the fit_to_height or fit_to_width methods.
  # @option options [Integer] width The number of pages to fit this worksheet on horizontally. Default 999
  # @option options [Integer] height The number of pages to fit this worksheet on vertically. Default 999
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:241
  def fit_to(options = T.unsafe(nil)); end

  # Number of vertical pages to fit on.
  # @note PageSetup#fit_to is the recommended way to manage page fitting as only specifying one of fit_to_width/fit_to_height will result in the counterpart
  # being set to 1.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:44
  def fit_to_height; end

  # @see fit_to_height
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:201
  def fit_to_height=(v); end

  # helper method for worksheet to determine if the page setup is configured for fit to page printing
  # We treat any page set up that has a value set for fit_to_width or fit_to_height value as fit_to_page.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:250
  def fit_to_page?; end

  # Number of horizontal pages to fit on.
  # @note PageSetup#fit_to is the recommended way to manage page fitting as only specifying one of width/height will result in the counterpart
  # being set to 1.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:50
  def fit_to_width; end

  # @see fit_to_width
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:207
  def fit_to_width=(v); end

  # Orientation of the page (:default, :landscape, :portrait)
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:54
  def orientation; end

  # @see orientation
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:213
  def orientation=(v); end

  # Height of paper (string containing a number followed by a unit identifier: "297mm", "11in")
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:58
  def paper_height; end

  # @see paper_height
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:219
  def paper_height=(v); end

  # The paper size to use in printing
  # 1 = Letter paper (8.5 in. by 11 in.)
  # 2 = Letter small paper (8.5 in. by 11 in.)
  # 3 = Tabloid paper (11 in. by 17 in.)
  # 4 = Ledger paper (17 in. by 11 in.)
  # 5 = Legal paper (8.5 in. by 14 in.)
  # 6 = Statement paper (5.5 in. by 8.5 in.)
  # 7 = Executive paper (7.25 in. by 10.5 in.)
  # 8 = A3 paper (297 mm by 420 mm)
  # 9 = A4 paper (210 mm by 297 mm)
  # 10 = A4 small paper (210 mm by 297 mm)
  # 11 = A5 paper (148 mm by 210 mm)
  # 12 = B4 paper (250 mm by 353 mm)
  # 13 = B5 paper (176 mm by 250 mm)
  # 14 = Folio paper (8.5 in. by 13 in.)
  # 15 = Quarto paper (215 mm by 275 mm)
  # 16 = Standard paper (10 in. by 14 in.)
  # 17 = Standard paper (11 in. by 17 in.)
  # 18 = Note paper (8.5 in. by 11 in.)
  # 19 = #9 envelope (3.875 in. by 8.875 in.)
