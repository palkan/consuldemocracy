# A GradientFill defines the color and positioning for gradient cell fill.
# @see Open Office XML Part 1 §18.8.24
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:6
class Axlsx::GradientFill
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new GradientFill object
  # @option options [Symbol] type
  # @option options [Float] degree
  # @option options [Float] left
  # @option options [Float] right
  # @option options [Float] top
  # @option options [Float] bottom
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:17
  def initialize(options = T.unsafe(nil)); end

  # Percentage format bottom
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:51
  def bottom; end

  # @see bottom
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:88
  def bottom=(v); end

  # Angle of the linear gradient
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:35
  def degree; end

  # @see degree
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:64
  def degree=(v); end

  # Percentage format left
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:39
  def left; end

  # @see left
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:70
  def left=(v); end

  # Percentage format right
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:43
  def right; end

  # @see right
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:76
  def right=(v); end

  # Collection of stop objects
  # @return [SimpleTypedList]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:55
  def stop; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:101
  def to_xml_string(str = T.unsafe(nil)); end

  # Percentage format top
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:47
  def top; end

  # @see top
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:82
  def top=(v); end

  # The type of gradient.
  # @note
  #  valid options are
  #   :linear
  #   :path
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:31
  def type; end

  # @see type
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:58
  def type=(v); end

  # validates that the value provided is between 0.0 and 1.0
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/gradient_fill.rb:94
  def validate_format_percentage(name, value); end
end

# The GradientStop object represents a color point in a gradient.
