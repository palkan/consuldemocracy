# rels content type
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:125
Axlsx::RELS_CT = T.let(T.unsafe(nil), String)

# rels content type extension
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:185
Axlsx::RELS_EX = T.let(T.unsafe(nil), String)

# rels part
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:209
Axlsx::RELS_PN = T.let(T.unsafe(nil), String)

# relationships name space
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:50
Axlsx::RELS_R = T.let(T.unsafe(nil), String)

# rels validation schema
#
# pkg:gem/caxlsx#lib/axlsx/util/constants.rb:263
Axlsx::RELS_XSD = T.let(T.unsafe(nil), String)

# Validate that the value provided is between a specific range
# Note that no data conversions will be done for you!
# Comparisons will be made using < and > or <= and <= when the inclusive parameter is true
#
# pkg:gem/caxlsx#lib/axlsx/util/validators.rb:22
class Axlsx::RangeValidator
  class << self
    # @param [String] name The name of what is being validated
    # @param [Any] min The minimum allowed value
    # @param [Any] max The maximum allowed value
    # @param [Any] value The value to be validated
    # @param [Boolean] inclusive Flag indicating if the comparison should be inclusive.
    #
    # pkg:gem/caxlsx#lib/axlsx/util/validators.rb:28
    def validate(name, min, max, value, inclusive = T.unsafe(nil)); end
  end
end

# Validates the value against the regular expression provided.
#
# pkg:gem/caxlsx#lib/axlsx/util/validators.rb:39
class Axlsx::RegexValidator
  class << self
    # @param [String] name The name of what is being validated. This is included in the output when the value is invalid
    # @param [Regexp] regex The regular expression to evaluate
    # @param [Any] v The value to validate.
    #
    # pkg:gem/caxlsx#lib/axlsx/util/validators.rb:43
    def validate(name, regex, v); end
  end
end

# A relationship defines a reference between package parts.
# @note Packages automatically manage relationships.
#
# pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:6
class Axlsx::Relationship
  # Initializes a new relationship.
  # @param [Object] source_obj see {#source_obj}
  # @param [String] type The type of the relationship
  # @param [String] target The target for the relationship
  # @option [Symbol] :target_mode only accepts :external.
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:86
  def initialize(source_obj, type, target, options = T.unsafe(nil)); end

  # The id of the relationship (eg. "rId123"). Most instances get their own unique id.
  # However, some instances need to share the same id – see {#ids_cache_key}
  # for details.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:49
  def Id; end

  # The location of the relationship target
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:53
  def Target; end

  # @see Target
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:95
  def Target=(v); end

  # The target mode of the relationship
  # used for hyperlink type relationships to mark the relationship to an external resource
  # TargetMode can be specified during initialization by passing in a :target_mode option
  # Target mode must be :external for now.
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:75
  def TargetMode; end

  # @see TargetMode
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:107
  def TargetMode=(v); end

  # The type of relationship
  # @note Supported types are defined as constants in Axlsx:
  # @see XML_NS_R
  # @see TABLE_R
  # @see PIVOT_TABLE_R
  # @see WORKBOOK_R
  # @see WORKSHEET_R
  # @see APP_R
  # @see RELS_R
  # @see CORE_R
  # @see STYLES_R
  # @see CHART_R
  # @see DRAWING_R
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:69
  def Type; end

  # @see Type
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:101
  def Type=(v); end

  # A key that determines whether this relationship should use already generated id.
  #
  # Instances designating the same relationship need to use the same id. We can not simply
  # compare the {#Target} attribute, though: `foo/bar.xml`, `../foo/bar.xml`,
  # `../../foo/bar.xml` etc. are all different but probably mean the same file (this
  # is especially an issue for relationships in the context of pivot tables). So lets
  # just ignore this attribute for now (except when {#TargetMode} is set to `:External` –
  # then {#Target} will be an absolute URL and thus can safely be compared).
  #
  # @todo Implement comparison of {#Target} based on normalized path names.
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:136
  def ids_cache_key; end

  # The source object the relations belongs to (e.g. a hyperlink, drawing, ...). Needed when
  # looking up the relationship for a specific object (see {Relationships#for}).
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:79
  def source_obj; end

  # serialize relationship
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:115
  def to_xml_string(str = T.unsafe(nil)); end

  class << self
    # Clear cached ids.
    #
    # This should be called after serializing a package (see {Package#serialize} and
    # {Package#to_stream}) to free the memory allocated for cache.
    #
    # Also, calling this avoids memory leaks (cached ids lingering around
    # forever).
    #
    # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:31
    def clear_ids_cache; end

    # Keeps track of relationship ids in use.
    # @return [Array]
    #
    # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:10
    def ids_cache; end

    # Initialize cached ids.
    #
    # This should be called before serializing a package (see {Package#serialize} and
    # {Package#to_stream}) to make sure that serialization is idempotent (i.e.
    # Relationship instances are generated with the same IDs every time the package
    # is serialized).
    #
    # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:20
    def initialize_ids_cache; end

    # Generate and return a unique id (eg. `rId123`) Used for setting {#Id}.
    #
    # The generated id depends on the number of previously cached ids, so using
    # {clear_ids_cache} will automatically reset the generated ids, too.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/rels/relationship.rb:40
    def next_free_id; end
  end
end

# Relationships are a collection of Relations that define how package parts are related.
# @note The package automatically manages relationships.
#
# pkg:gem/caxlsx#lib/axlsx/rels/relationships.rb:8
class Axlsx::Relationships < ::Axlsx::SimpleTypedList
  # Creates a new Relationships collection based on SimpleTypedList
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationships.rb:10
  def initialize; end

  # The relationship instance for the given source object, or nil if none exists.
  # @see Relationship#source_obj
  # @return [Relationship]
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationships.rb:17
  def for(source_obj); end

  # serialize relationships
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/rels/relationships.rb:24
  def to_xml_string(str = T.unsafe(nil)); end
end

# Validate a value against a specific list of allowed values.
#
# pkg:gem/caxlsx#lib/axlsx/util/validators.rb:5
class Axlsx::RestrictionValidator
  class << self
    # Perform validation
    # @param [String] name The name of what is being validatied. This is included in the error message
    # @param [Array] choices The list of choices to validate against
    # @param [Any] v The value to be validated
    # @raise [ArgumentError] Raised if the value provided is not in the list of choices.
    # @return [Boolean] true if validation succeeds.
    #
    # pkg:gem/caxlsx#lib/axlsx/util/validators.rb:12
    def validate(name, choices, v); end
  end
end

# A simple, self serializing class for storing TextRuns
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:5
class Axlsx::RichText < ::Axlsx::SimpleTypedList
  # creates a new RichText collection
  # @param [String] text -optional The text to use in creating the first RichTextRun
  # @param [Object] options -optional The options to use in creating the first RichTextRun
  # @yield [RichText] self
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:10
  def initialize(text = T.unsafe(nil), options = T.unsafe(nil)); end

  # Creates and adds a RichTextRun to this collectino
  # @param [String] text The text to use in creating a new RichTextRun
  # @param [Object] options The options to use in creating the new RichTextRun
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:37
  def add_run(text, options = T.unsafe(nil)); end

  # Calculates the longest autowidth of the RichTextRuns in this collection
  # @return [Number]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:28
  def autowidth; end

  # The cell that owns this RichText collection
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:17
  def cell; end

  # Assign the cell for this RichText collection
  # @param [Cell] cell The cell which all RichTextRuns in the collection will belong to
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:21
  def cell=(cell); end

  # The RichTextRuns we own
  # @return [RichText]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:43
  def runs; end

  # renders the RichTextRuns in this collection
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text.rb:50
  def to_xml_string(str = T.unsafe(nil)); end
end

# The RichTextRun class creates and self serializing text run.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:5
class Axlsx::RichTextRun
  include ::Axlsx::OptionsParser

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:16
  def initialize(value, options = T.unsafe(nil)); end

  # Tries to work out the width of the longest line in the run
  # @param [Array] widtharray this array is populated with the widths of each line in the run.
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:198
  def autowidth(widtharray); end

  # The inline bold property for the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:81
  def b; end

  # @see b
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:84
  def b=(v); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:25
  def cell; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:25
  def cell=(_arg0); end

  # The inline charset property for the cell
  # As far as I can tell, this is pretty much ignored. However, based on the spec it should be one of the following:
  # 0 ￼ ANSI_CHARSET
  # 1 DEFAULT_CHARSET
  # 2 SYMBOL_CHARSET
  # 77 MAC_CHARSET
  # 128 SHIFTJIS_CHARSET
  # 129 ￼ HANGUL_CHARSET
  # 130 ￼ JOHAB_CHARSET
  # 134 ￼ GB2312_CHARSET
  # 136 ￼ CHINESEBIG5_CHARSET
  # 161 ￼ GREEK_CHARSET
  # 162 ￼ TURKISH_CHARSET
  # 163 ￼ VIETNAMESE_CHARSET
  # 177 ￼ HEBREW_CHARSET
  # 178 ￼ ARABIC_CHARSET
  # 186 ￼ BALTIC_CHARSET
  # 204 ￼ RUSSIAN_CHARSET
  # 222 ￼ THAI_CHARSET
  # 238 ￼ EASTEUROPE_CHARSET
  # 255 ￼ OEM_CHARSET
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:58
  def charset; end

  # @see charset
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:61
  def charset=(v); end

  # The inline color property for the cell
  # @return [Color]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:157
  def color; end

  # @param [String] v The 8 character representation for an rgb color #FFFFFFFF"
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:160
  def color=(v); end

  # The inline condense property for the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:126
  def condense; end

  # @see condense
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:129
  def condense=(v); end

  # The inline extend property for the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:135
  def extend; end

  # @see extend
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:138
  def extend=(v); end

  # The inline family property for the cell
  # @return [Integer]
  # 1 Roman
  # 2 Swiss
  # 3 Modern
  # 4 Script
  # 5 Decorative
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:72
  def family; end

  # @see family
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:75
  def family=(v); end

  # The inline font_name property for the cell
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:29
  def font_name; end

  # @see font_name
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:32
  def font_name=(v); end

  # The inline italic property for the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:90
  def i; end

  # @see i
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:93
  def i=(v); end

  # The inline outline property for the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:108
  def outline; end

  # @see outline
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:111
  def outline=(v); end

  # The inline scheme property for the cell
  # this must be one of [:none, major, minor]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:187
  def scheme; end

  # @see scheme
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:190
  def scheme=(v); end

  # Utility method for setting inline style attributes
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:218
  def set_run_style(validator, attr, value); end

  # The inline shadow property for the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:117
  def shadow; end

  # @see shadow
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:120
  def shadow=(v); end

  # The inline strike property for the cell
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:99
  def strike; end

  # @see strike
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:102
  def strike=(v); end

  # The inline sz property for the cell
  # @return [Inteter]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:166
  def sz; end

  # @see sz
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:169
  def sz=(v); end

  # Serializes the RichTextRun
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:228
  def to_xml_string(str = T.unsafe(nil)); end

  # The inline underline property for the cell.
  # It must be one of :none, :single, :double, :singleAccounting, :doubleAccounting, true
  # @return [Boolean]
  # @return [String]
  # @note true is for backwards compatibility and is reassigned to :single
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:147
  def u; end

  # @see u
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:150
  def u=(v); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:8
  def value; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:21
  def value=(value); end

  # The inline vertical alignment property for the cell
  # this must be one of [:baseline, :subscript, :superscript]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:176
  def vertAlign; end

  # @see vertAlign
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:179
  def vertAlign=(v); end

  private

  # we scale the font size if bold style is applied to either the style font or
  # the cell itself. Yes, it is a bit of a hack, but it is much better than using
  # imagemagick and loading metrics for every character.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:261
  def font_size; end

  # Returns the width of a string according to the current style
  # This is still not perfect...
  #  - scaling is not linear as font sizes increase
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:253
  def string_width(string, font_size); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:268
  def style; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:272
  def styles; end

  # Converts the value to the correct XML representation (fixes issues with
  # Numbers)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:278
  def xml_value(value); end
end

# A list of allowed inline style attributes used for validation
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/rich_text_run.rb:11
Axlsx::RichTextRun::INLINE_STYLES = T.let(T.unsafe(nil), Array)

# A Row is a single row in a worksheet.
# @note The recommended way to manage rows and cells is to use Worksheet#add_row
# @see Worksheet#add_row
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:7
class Axlsx::Row < ::Axlsx::SimpleTypedList
  include ::Axlsx::SerializedAttributes
  include ::Axlsx::Accessors
  extend ::Axlsx::SerializedAttributes::ClassMethods
  extend ::Axlsx::Accessors::ClassMethods

  # Creates a new row. New Cell objects are created based on the values, types and style options.
  # A new cell is created for each item in the values array. style and types options are applied as follows:
  #   If the types option is defined and is a symbol it is applied to all the cells created.
  #   If the types option is an array, cell types are applied by index for each cell
  #   If the types option is not set, the cell will automatically determine its type.
  #   If the style option is defined and is an Integer, it is applied to all cells created.
  #   If the style option is an array, style is applied by index for each cell.
  #   If the style option is not defined, the default style (0) is applied to each cell.
  # @param [Worksheet] worksheet
  # @option options [Array] values
  # @option options [Array, Symbol] types
  # @option options [Array, Integer] style
  # @option options [Array, Boolean] escape_formulas
  # @option options [Float] height the row's height (in points)
  # @option options [Integer] offset - add empty columns before values
  # @see Row#array_to_cells
  # @see Cell
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:33
  def initialize(worksheet, values = T.unsafe(nil), options = T.unsafe(nil)); end

  # Adds a single cell to the row based on the data provided and updates the worksheet's autofit data.
  # @return [Cell]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:99
  def add_cell(value = T.unsafe(nil), options = T.unsafe(nil)); end

  # return cells
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:139
  def cells; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def collapsed; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def collapsed=(value); end

  # Sets the color for every cell in this row.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:107
  def color=(color); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def custom_format; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def custom_format=(value); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def custom_height; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def custom_height=(value); end

  # Sets escape_formulas for every cell in this row. This determines whether to treat
  # values starting with an equals sign as formulas or as literal strings.
  # @param [Array, Boolean] value The value to set.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:123
  def escape_formulas=(value); end

  # Row height measured in point size. There is no margin padding on row height.
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:53
  def height; end

  # @see height
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:130
  def height=(v); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def hidden; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def hidden=(value); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:60
  def outlineLevel; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:79
  def outlineLevel=(v); end

  # Outlining level of the row, when outlining is on
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:59
  def outline_level; end

  # @see Row#outline
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:74
  def outline_level=(v); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def ph; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:45
  def ph=(value); end

  # The index of this row in the worksheet
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:83
  def row_index; end

  # The style applied to the row. This affects the entire row.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:64
  def s; end

  # @see Row#s
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:67
  def s=(v); end

  # Sets the style for every cell in this row.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:114
  def style=(style); end

  # Serializes the row
  # @param [Integer] r_index The row index, 0 based.
  # @param [String] str The string this rows xml will be appended to.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:91
  def to_xml_string(r_index, str = T.unsafe(nil)); end

  # The worksheet this row belongs to
  # @return [Worksheet]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:49
  def worksheet; end

  private

  # Converts values, types, and style options into cells and associates them with this row.
  # A new cell is created for each item in the values array.
  # If value option is defined and is a symbol it is applied to all the cells created.
  # If the value option is an array, cell types are applied by index for each cell
  # If the style option is defined and is an Integer, it is applied to all cells created.
  # If the style option is an array, style is applied by index for each cell.
  # @option options [Array] values
  # @option options [Array, Symbol] types
  # @option options [Array, Integer] style
  # @option options [Array, Boolean] escape_formulas
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:161
  def array_to_cells(values, options = T.unsafe(nil)); end

  # assigns the owning worksheet for this row
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row.rb:146
  def worksheet=(v); end
end

# A collection of break objects that define row breaks (page breaks) for printing and preview
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row_breaks.rb:6
class Axlsx::RowBreaks < ::Axlsx::SimpleTypedList
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row_breaks.rb:7
  def initialize; end

  # Adds a row break
  # @param [Hash] options The options for the break to be created.
  # max and man values are fixed.
  # @see Break
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row_breaks.rb:15
  def add_break(options); end

  # <rowBreaks count="3" manualBreakCount="3">
  # <brk id="1" max="16383" man="1"/>
  # <brk id="7" max="16383" man="1"/>
  # <brk id="13" max="16383" man="1"/>
  # </rowBreaks>
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/row_breaks.rb:26
  def to_xml_string(str = T.unsafe(nil)); end
end

