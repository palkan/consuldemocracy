# A Title stores information about the title of a chart
#
# pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:5
class Axlsx::Title
  # Creates a new Title object
  # @param [String, Cell] title The cell or string to be used for the chart's title
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:20
  def initialize(title = T.unsafe(nil), title_size = T.unsafe(nil)); end

  # The cell that holds the text for the title. Setting this property will automatically update the text attribute.
  # @return [Cell]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:16
  def cell; end

  # @see cell
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:45
  def cell=(v); end

  # Check if the title is empty.
  #
  # A title is considered empty if it is an empty string. If the title references a cell it is *not* empty,
  # even if the referenced cell is blank (because the cell’s value could still change later).
  #
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:57
  def empty?; end

  # The text to be shown. Setting this property directly with a string will remove the cell reference.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:8
  def text; end

  # @see text
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:31
  def text=(v); end

  # Text size property
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:12
  def text_size; end

  # @see text_size
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:38
  def text_size=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/title.rb:69
  def to_xml_string(str = T.unsafe(nil)); end
end

# This class details the anchor points for drawings.
# @note The recommended way to manage drawings and charts is Worksheet#add_chart. Anchors are specified by the :start_at and :end_at options to that method.
# @see Worksheet#add_chart
#
# pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:7
class Axlsx::TwoCellAnchor
  include ::Axlsx::OptionsParser

  # Creates a new TwoCellAnchor object
  # c.start_at 5, 9
  # @param [Drawing] drawing
  # @option options [Array] :start_at the col, row to start at THIS IS DOCUMENTED BUT NOT IMPLEMENTED HERE!
  # @option options [Array] :end_at the col, row to end at
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:35
  def initialize(drawing, options = T.unsafe(nil)); end

  # Creates a graphic frame and chart object associated with this anchor
  # @return [Chart]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:65
  def add_chart(chart_type, options); end

  # Creates an image associated with this anchor.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:71
  def add_pic(options = T.unsafe(nil)); end

  # The drawing that holds this anchor
  # @return [Drawing]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:28
  def drawing; end

  # sets the col, row attributes for the to marker
  # @note the recommended way to set the to position for graphical
  # objects is directly thru the object
  # @see Char#end_at
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:59
  def end_at(x, y = T.unsafe(nil)); end

  # A marker that defines the from cell anchor. The default from column and row are 0 and 0 respectively
  # @return [Marker]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:12
  def from; end

  # The index of this anchor in the drawing
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:77
  def index; end

  # The object this anchor hosts
  # @return [Pic, GraphicFrame]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:24
  def object; end

  # sets the col, row attributes for the from marker.
  # @note The recommended way to set the start position for graphical
  # objects is directly thru the object.
  # @see Chart#start_at
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:51
  def start_at(x, y = T.unsafe(nil)); end

  # A marker that returns the to cell anchor. The default to column and row are 5 and 10 respectively
  # @return [Marker]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:15
  def to; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/two_cell_anchor.rb:84
  def to_xml_string(str = T.unsafe(nil)); end
end

