  # @see tick_mark_skip
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:53
  def tick_mark_skip=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:84
