  #
  # pkg:gem/caxlsx#lib/axlsx/content_type/content_type.rb:17
  def to_xml_string(str = T.unsafe(nil)); end
end

# The core object for the package.
# @note Packages manage their own core object.
# @see Package#core
#
# pkg:gem/caxlsx#lib/axlsx/doc_props/core.rb:7
class Axlsx::Core
  # Creates a new Core object.
  # @option options [String] creator
  # @option options [Time] created
  #
  # pkg:gem/caxlsx#lib/axlsx/doc_props/core.rb:11
  def initialize(options = T.unsafe(nil)); end

  # Creation time of the document. If nil, the current time will be used.
  #
  # pkg:gem/caxlsx#lib/axlsx/doc_props/core.rb:21
  def created; end

  # Creation time of the document. If nil, the current time will be used.
  #
  # pkg:gem/caxlsx#lib/axlsx/doc_props/core.rb:21
  def created=(_arg0); end

  # The author of the document. By default this is 'axlsx'
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/doc_props/core.rb:18
  def creator; end

  # The author of the document. By default this is 'axlsx'
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/doc_props/core.rb:18
  def creator=(_arg0); end

  # serializes the core.xml document
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/doc_props/core.rb:25
  def to_xml_string(str = T.unsafe(nil)); end
end

