# A CatAxis object defines a chart category axis
#
# pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:5
class Axlsx::CatAxis < ::Axlsx::Axis
  # Creates a new CatAxis object
  # @option options [Integer, nil] tick_lbl_skip
  # @option options [Integer, nil] tick_mark_skip
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:9
  def initialize(options = T.unsafe(nil)); end

  # From the docs: This element specifies that this axis is a date or text axis based on the data that is used for the axis labels, not a specific choice.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:18
  def auto; end

  # From the docs: This element specifies that this axis is a date or text axis based on the data that is used for the axis labels, not a specific choice.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:60
  def auto=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:24
  def lblAlgn; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:71
  def lblAlgn=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:30
  def lblOffset; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:79
  def lblOffset=(v); end

  # specifies how the perpendicular axis is crossed
  # must be one of [:ctr, :l, :r]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:23
  def lbl_algn; end

  # specifies how the perpendicular axis is crossed
  # must be one of [:ctr, :l, :r]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:67
  def lbl_algn=(v); end

  # The offset of the labels
  # must be between a string between 0 and 1000
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:29
  def lbl_offset; end

  # The offset of the labels
  # must be between a string between 0 and 1000
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:75
  def lbl_offset=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:35
  def tickLblSkip; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:50
  def tickLblSkip=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:40
  def tickMarkSkip; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:57
