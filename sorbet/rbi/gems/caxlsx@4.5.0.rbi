  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:250
  def i; end

  # @see i
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:253
  def i=(v); end

  # @return [Integer] The index of the cell in the containing row.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:359
  def index; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:419
  def is_array_formula?; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:413
  def is_formula?; end

