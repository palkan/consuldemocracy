  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:395
  def merge(target); end

  # returns the name of the cell
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:443
  def name; end

  # Creates a defined name in the workbook for this cell.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:437
  def name=(label); end

  # The inline outline property for the cell
