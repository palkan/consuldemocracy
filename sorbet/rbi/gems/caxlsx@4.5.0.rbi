# The Scaling class defines axis scaling
#
# pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:5
class Axlsx::Scaling
  include ::Axlsx::OptionsParser

  # creates a new Scaling object
  # @option options [Integer] logBase
  # @option options [Symbol] orientation
  # @option options [Float] max
  # @option options [Float] min
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:13
  def initialize(options = T.unsafe(nil)); end

  # logarithmic base for a logarithmic axis.
  # must be between 2 and 1000
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:22
  def logBase; end

  # @see logBase
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:38
  def logBase=(v); end

  # the maximum scaling
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:31
  def max; end

  # @see max
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:50
  def max=(v); end

  # the minimu scaling
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:35
  def min; end

  # @see min
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:56
  def min=(v); end

  # the orientation of the axis
  # must be one of [:minMax, :maxMin]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:27
  def orientation; end

  # @see orientation
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:44
  def orientation=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/scaling.rb:64
  def to_xml_string(str = T.unsafe(nil)); end
end

# The ScatterChart allows you to insert a scatter chart into your worksheet
