  # @see tick_lbl_skip
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:46
  def tick_lbl_skip=(v); end

  # The number of tickmarks to be skipped before the next one is rendered.
  # @return [Integer, nil]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/cat_axis.rb:39
