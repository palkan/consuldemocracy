  # @return [SimpleTypedList] A list of BorderPr objects for this border.
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:43
  def prs; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/border.rb:68
  def to_xml_string(str = T.unsafe(nil)); end
end

