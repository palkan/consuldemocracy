# Table
# @note Worksheet#add_pivot_table is the recommended way to create tables for your worksheets.
# @see README for examples
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:7
class Axlsx::PivotTable
  include ::Axlsx::OptionsParser

  # Creates a new PivotTable object
  # @param [String] ref The reference to where the pivot table lives like 'G4:L17'.
  # @param [String] range The reference to the pivot table data like 'A1:D31'.
  # @param [Worksheet] sheet The sheet containing the table data.
  # @option options [Cell, String] name
  # @option options [TableStyle] style
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:16
  def initialize(ref, range, sheet, options = T.unsafe(nil)); end

  # Whether to apply width/height formats to the pivot table.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:96
  def apply_width_height_formats; end

  # Whether to apply width/height formats to the pivot table.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:96
  def apply_width_height_formats=(_arg0); end

  # The cache_definition for this pivot table
  # @return [PivotTableCacheDefinition]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:198
  def cache_definition; end

  # The columns
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:130
  def columns; end

  # (see #columns)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:133
  def columns=(v); end

  # The data as an array of either headers (String) or hashes or mix of the two.
  # Hash in format of { ref: header, num_fmt: numFmts, subtotal: subtotal }, where header is String, numFmts is Integer, and subtotal one of %w[sum count average max min product countNums stdDev stdDevp var varp]; leave subtotal blank to sum values
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:144
  def data; end

  # (see #data)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:147
  def data=(v); end

  # The sheet used as data source for the pivot table
  # @return [Worksheet]
  # @see #data_sheet
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:99
  def data_sheet; end

  # The sheet used as data source for the pivot table
  # @return [Worksheet]
  # @see #data_sheet
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:88
  def data_sheet=(_arg0); end

  # Defines which Grand Totals are to be shown.
  # @return [Symbol] The row and/or column Grand Totals that are to be shown.
  # Defaults to `:both` to show both row & column grand totals.
  # Set to `:row_only`, `:col_only`, or `:none` to hide one or both Grand Totals.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:61
  def grand_totals; end

  # (see #grand_totals)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:64
  def grand_totals=(value); end

  # References for header cells
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:315
  def header_cell_refs; end

  # The values in the header cells collection
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:327
  def header_cell_values; end

  # The header cells for the pivot table
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:321
  def header_cells; end

  # The number of cells in the header_cells collection
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:333
  def header_cells_count; end

  # The index of a given value in the header cells
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:339
  def header_index_of(value); end

  # The index of this chart in the workbooks charts collection
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:180
  def index; end

  # The name of the table.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:80
  def name; end

  # Defines the headers in which subtotals are not to be included.
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:40
  def no_subtotals_on_headers; end

  # Defines the headers in which subtotals are not to be included.
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:40
  def no_subtotals_on_headers=(_arg0); end

  # The pages
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:167
  def pages; end

  # (see #pages)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:170
  def pages=(v); end

  # The part name for this table
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:186
  def pn; end

  # The range where the data for this pivot table lives.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:105
  def range; end

  # (see #range)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:108
  def range=(v); end

  # The reference to the table data
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:76
  def ref; end

  # The relationships for this pivot table.
  # @return [Relationships]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:204
  def relationships; end

  # The relationship part name of this pivot table
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:192
  def rels_pn; end

  # The rows
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:117
  def rows; end

  # (see #rows)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:120
  def rows=(v); end

  # The name of the sheet.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:84
  def sheet; end

  # Defines the headers in which sort is applied.
  # Can be an array of headers to sort ascending by default, or a hash for specific control
  # (with headers as keys, `:ascending` or `:descending` as values).
  #
  # Examples: `["year", "month"]` or `{"year" => :descending, "month" => :descending}`
  # @return [Hash]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:48
  def sort_on_headers; end

  # (see #sort_on_headers)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:51
  def sort_on_headers=(headers); end

  # Style info for the pivot table
  # @return [Hash]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:72
  def style_info; end

  # Style info for the pivot table
  # @return [Hash]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:72
  def style_info=(_arg0); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:213
  def to_xml_string(str = T.unsafe(nil)); end

  # Whether to apply auto formatting to the pivot table.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:92
  def use_auto_formatting; end

  # Whether to apply auto formatting to the pivot table.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:92
  def use_auto_formatting=(_arg0); end

  private

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:376
  def data_refs; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:380
  def header_range; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pivot_table.rb:345
  def pivot_field_for(cell_ref, subtotal, sorttype); end
end

