# Table
# @note Worksheet#add_table is the recommended way to create tables for your worksheets.
# @see README for examples
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:7
class Axlsx::Table
  include ::Axlsx::OptionsParser

  # Creates a new Table object
  # @param [String] ref The reference to the table data like 'A1:G24'.
  # @param [Worksheet] sheet The sheet containing the table data.
  # @option options [Cell, String] name
  # @option options [TableStyle] style
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:15
  def initialize(ref, sheet, options = T.unsafe(nil)); end

  # The index of this chart in the workbooks charts collection
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:40
  def index; end

  # The name of the table.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:32
  def name; end

  # The name of the Table.
  # @param [String, Cell] v
  # @return [Title]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:60
  def name=(v); end

  # The part name for this table
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:46
  def pn; end

  # The relationship id for this table.
  # @see Relationship#Id
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:53
  def rId; end

  # The reference to the table data
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:28
  def ref; end

  # The style for the table.
  # @return [TableStyle]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:36
  def style; end

  # TableStyleInfo for the table.
  # initialization can be fed via the :style_info option
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:69
  def table_style_info; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:76
  def to_xml_string(str = T.unsafe(nil)); end

  private

  # get the header cells (hackish)
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table.rb:97
  def header_cells; end
end

# A single table style definition and is a collection for tableStyleElements
# @note Table are not supported in this version and only the defaults required for a valid workbook are created.
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:6
class Axlsx::TableStyle < ::Axlsx::SimpleTypedList
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # creates a new TableStyle object
  # @raise [ArgumentError] if name option is not provided.
  # @param [String] name
  # @option options [Boolean] pivot
  # @option options [Boolean] table
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:15
  def initialize(name, options = T.unsafe(nil)); end

  # The name of this table style
  # @return [string]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:25
  def name; end

  # @see name
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:36
  def name=(v); end

  # indicates if this style should be applied to pivot tables
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:29
  def pivot; end

  # @see pivot
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:42
  def pivot=(v); end

  # indicates if this style should be applied to tables
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:33
  def table; end

  # @see table
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:48
  def table=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style.rb:56
  def to_xml_string(str = T.unsafe(nil)); end
end

# an element of style that belongs to a table style.
# @note tables and table styles are not supported in this version. This class exists in preparation for that support.
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:6
class Axlsx::TableStyleElement
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # creates a new TableStyleElement object
  # @option options [Symbol] type
  # @option options [Integer] size
  # @option options [Integer] dxfId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:14
  def initialize(options = T.unsafe(nil)); end

  # The dxfId this style element points to
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:58
  def dxfId; end

  # @see dxfId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:73
  def dxfId=(v); end

  # Number of rows or columns used in striping when the type is firstRowStripe, secondRowStripe, firstColumnStripe, or secondColumnStripe.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:54
  def size; end

  # @see size
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:67
  def size=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:81
  def to_xml_string(str = T.unsafe(nil)); end

  # The type of style element. The following type are allowed
  #   :wholeTable
  #   :headerRow
  #   :totalRow
  #   :firstColumn
  #   :lastColumn
  #   :firstRowStripe
  #   :secondRowStripe
  #   :firstColumnStripe
  #   :secondColumnStripe
  #   :firstHeaderCell
  #   :lastHeaderCell
  #   :firstTotalCell
  #   :lastTotalCell
  #   :firstSubtotalColumn
  #   :secondSubtotalColumn
  #   :thirdSubtotalColumn
  #   :firstSubtotalRow
  #   :secondSubtotalRow
  #   :thirdSubtotalRow
  #   :blankRow
  #   :firstColumnSubheading
  #   :secondColumnSubheading
  #   :thirdColumnSubheading
  #   :firstRowSubheading
  #   :secondRowSubheading
  #   :thirdRowSubheading
  #   :pageFieldLabels
  #   :pageFieldValues
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:50
  def type; end

  # @see type
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_style_element.rb:61
  def type=(v); end
end

# The table style info class manages style attributes for defined tables in
# a worksheet
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:6
class Axlsx::TableStyleInfo
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  include ::Axlsx::Accessors
  extend ::Axlsx::SerializedAttributes::ClassMethods
  extend ::Axlsx::Accessors::ClassMethods

  # creates a new TableStyleInfo instance
  # @param [Hash] options
  # @option [Boolean] show_first_column indicates if the first column should
  #                   be shown
  # @option [Boolean] show_last_column indicates if the last column should
  #                   be shown
  # @option [Boolean] show_column_stripes indicates if column stripes should
  #                   be shown
  # @option [Boolean] show_row_stripes indicates if row stripes should be shown
  # @option [String] name The name of the style to apply to your table.
  #                  Only predefined styles are currently supported.
  #                  @see Annex G. (normative) Predefined SpreadsheetML Style Definitions in part 1 of the specification.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:23
  def initialize(options = T.unsafe(nil)); end

  # Initialize all the values to false as Excel requires them to
  # explicitly be disabled or all will show.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:36
  def initialize_defaults; end

  # The name of the table style.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:43
  def name; end

  # The name of the table style.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:43
  def name=(_arg0); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_column_stripes; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_column_stripes=(value); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_first_column; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_first_column=(value); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_last_column; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_last_column=(value); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_row_stripes; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:30
  def show_row_stripes=(value); end

  # serializes this object to an xml string
  # @param [String] str the string to contact this objects serialization to.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/table_style_info.rb:47
  def to_xml_string(str = T.unsafe(nil)); end
end

# TableStyles represents a collection of style definitions for table styles and pivot table styles.
# @note Support for custom table styles does not exist in this version. Many of the classes required are defined in preparation for future release. Please do not attempt to add custom table styles.
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/table_styles.rb:6
class Axlsx::TableStyles < ::Axlsx::SimpleTypedList
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new TableStyles object that is a container for TableStyle objects
  # @option options [String] defaultTableStyle
  # @option options [String] defaultPivotStyle
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_styles.rb:12
  def initialize(options = T.unsafe(nil)); end

  # The default pivot table style. The default value is  'PivotStyleLight6'
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_styles.rb:26
  def defaultPivotStyle; end

  # @see defaultPivotStyle
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_styles.rb:35
  def defaultPivotStyle=(v); end

  # The default table style. The default value is 'TableStyleMedium9'
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_styles.rb:22
  def defaultTableStyle; end

  # @see defaultTableStyle
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_styles.rb:29
  def defaultTableStyle=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/table_styles.rb:43
  def to_xml_string(str = T.unsafe(nil)); end
end

