  # The direction of the bars in the chart
  # must be one of [:bar, :col]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:86
  def bar_dir=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:15
  def catAxis; end

  # the category axis
  # @return [CatAxis]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:12
  def cat_axis; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:35
  def gapDepth; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:111
  def gapDepth=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:42
  def gapWidth; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:104
  def gapWidth=(v); end

  # space between bar or column clusters, as a percentage of the bar or column width.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:34
  def gap_depth; end

  # space between bar or column clusters, as a percentage of the bar or column width.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:107
  def gap_depth=(v); end

  # space between bar or column clusters, as a percentage of the bar or column width.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:39
  def gap_width; end

  # space between bar or column clusters, as a percentage of the bar or column width.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:100
  def gap_width=(v); end

  # grouping for a column, line, or area chart.
  # must be one of  [:percentStacked, :clustered, :standard, :stacked]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:47
  def grouping; end

  # grouping for a column, line, or area chart.
  # must be one of  [:percentStacked, :clustered, :standard, :stacked]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:94
  def grouping=(v); end

  # The shabe of the bars or columns
  # must be one of  [:cone, :coneToMax, :box, :cylinder, :pyramid, :pyramidToMax]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/bar_3D_chart.rb:54
  def shape; end

  # The shabe of the bars or columns
  # must be one of  [:cone, :coneToMax, :box, :cylinder, :pyramid, :pyramidToMax]
  #
