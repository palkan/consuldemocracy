  #   ws.rows.first.cells.first.r #=> "A1"
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:366
  def r; end

  # @return [String] The absolute alpha(column)numeric(row) reference for this cell.
