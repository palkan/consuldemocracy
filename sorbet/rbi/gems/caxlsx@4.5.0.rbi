# A NumFmt object defines an identifier and formatting code for data in cells.
# @note The recommended way to manage styles is Styles#add_style
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:6
class Axlsx::NumFmt
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new NumFmt object
  # @param [Hash] options Options for the number format object
  # @option [Integer] numFmtId The predefined format id or new format id for this format
  # @option [String] formatCode The format code for this number format
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:14
  def initialize(options = T.unsafe(nil)); end

  # @return [String] The formatting to use for this number format.
  # @see https://support.microsoft.com/kb/264372
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:24
  def formatCode; end

  # @see formatCode
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:70
  def formatCode=(v); end

  # @return [Integer] An unsigned integer referencing a standard or custom number format.
  # @note
  #  These are the known formats I can dig up. The constant NUM_FMT_PERCENT is 9, and uses the default % formatting. Axlsx also defines a few formats for date and time that are commonly used in asia as NUM_FMT_YYYYMMDD and NUM_FRM_YYYYMMDDHHMMSS.
  #   1 0
  #   2 0.00
  #   3 #,##0
  #   4 #,##0.00
  #   5 $#,##0_);($#,##0)
  #   6 $#,##0_);[Red]($#,##0)
  #   7 $#,##0.00_);($#,##0.00)
  #   8 $#,##0.00_);[Red]($#,##0.00)
  #   9 0%
  #   10 0.00%
  #   11 0.00E+00
  #   12 # ?/?
  #   13 # ??/??
  #   14 m/d/yyyy
  #   15 d-mmm-yy
  #   16 d-mmm
  #   17 mmm-yy
  #   18 h:mm AM/PM
  #   19 h:mm:ss AM/PM
  #   20 h:mm
  #   21 h:mm:ss
  #   22 m/d/yyyy h:mm
  #   37 #,##0_);(#,##0)
  #   38 #,##0_);[Red](#,##0)
  #   39 #,##0.00_);(#,##0.00)
  #   40 #,##0.00_);[Red](#,##0.00)
  #   45 mm:ss
  #   46 [h]:mm:ss
  #   47 mm:ss.0
  #   48 ##0.0E+0
  #   49 @
  # @see Axlsx
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:61
  def numFmtId; end

  # @see numFmtId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:64
  def numFmtId=(v); end

  # Override to avoid removing underscores
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:83
  def serialized_attributes(str = T.unsafe(nil), additional_attributes = T.unsafe(nil)); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/num_fmt.rb:78
  def to_xml_string(str = T.unsafe(nil)); end
end

# This class specifies data for a particular data point.
#
# pkg:gem/caxlsx#lib/axlsx/drawing/num_val.rb:5
class Axlsx::NumVal < ::Axlsx::StrVal
  # creates a new NumVal object
  # @option options [String] formatCode
  # @option options [Integer] v
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/num_val.rb:14
  def initialize(options = T.unsafe(nil)); end

  # A string representing the format code to apply.
  # For more information see see the SpreadsheetML numFmt element's (§18.8.30) formatCode attribute.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/num_val.rb:9
  def format_code; end

  # @see format_code
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/num_val.rb:20
  def format_code=(v); end

  # serialize the object
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/num_val.rb:26
  def to_xml_string(idx, str = T.unsafe(nil)); end
end

# This class details a single cell anchor for drawings.
# @note The recommended way to manage drawings, images and charts is Worksheet#add_chart or Worksheet#add_image.
# @see Worksheet#add_chart
# @see Worksheet#add_image
#
# pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:8
class Axlsx::OneCellAnchor
  include ::Axlsx::OptionsParser

  # Creates a new OneCellAnchor object and an Pic associated with it.
  # @param [Drawing] drawing
  # @option options [Array] start_at the col, row to start at
  # @option options [Integer] width
  # @option options [Integer] height
  # @option options [String] image_src the file location of the image you will render
  # @option options [String] name the name attribute for the rendered image
  # @option options [String] descr the description of the image rendered
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:19
  def initialize(drawing, options = T.unsafe(nil)); end

  # The drawing that holds this anchor
  # @return [Drawing]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:40
  def drawing; end

  # A marker that defines the from cell anchor. The default from column and row are 0 and 0 respectively
  # @return [Marker]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:32
  def from; end

  # the height of the graphic object in pixels
  # this is converted to EMU at a 92 ppi resolution
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:50
  def height; end

  # @see height
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:63
  def height=(v); end

  # The index of this anchor in the drawing
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:76
  def index; end

  # The object this anchor hosts
  # @return [Pic]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:36
  def object; end

  # sets the starting position for the anchor.
  # You can provide a String like "A1", an array like [0,0] or a cell object for the x parameter.
  # We just 'figure it out' for you.
  # @param [Array, String, Cell, Integer] x Accepts many inputs for defining the starting position of the cell.
  # @param [Integer] y When x is an integer, this value is used for the row index at which the anchor starts.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:57
  def start_at(x, y = T.unsafe(nil)); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:83
  def to_xml_string(str = T.unsafe(nil)); end

  # the width of the graphic object in pixels.
  # this is converted to EMU at a 92 ppi resolution
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:45
  def width; end

  # @see width
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:69
  def width=(v); end

  private

  # converts the pixel width and height to EMU units and returns a hash of
  # !{:cx=>[Integer], :cy=>[Integer]
  # @return [Hash]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/one_cell_anchor.rb:99
  def ext; end
end

# This module defines a single method for parsing options in class
# initializers.
#
# pkg:gem/caxlsx#lib/axlsx/util/options_parser.rb:6
module Axlsx::OptionsParser
  # Parses an options hash by calling any defined method by the same
  # name of the key postfixed with an '='
  # @param [Hash] options Options to parse.
  #
  # pkg:gem/caxlsx#lib/axlsx/util/options_parser.rb:10
  def parse_options(options = T.unsafe(nil)); end
end

# The OutlinePr class manages serialization of a worksheet's outlinePr element, which provides various
# options to control outlining.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/outline_pr.rb:6
class Axlsx::OutlinePr
  include ::Axlsx::OptionsParser
  include ::Axlsx::Accessors
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::Accessors::ClassMethods
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new OutlinePr object
  # @param [Hash] options used to create the outline_pr
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/outline_pr.rb:23
  def initialize(options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/outline_pr.rb:17
  def apply_styles; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/outline_pr.rb:17
