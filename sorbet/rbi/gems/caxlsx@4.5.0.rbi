  # 39 = US standard fanfold (14.875 in. by 11 in.)
  # 40 = German standard fanfold (8.5 in. by 12 in.)
  # 41 = German legal fanfold (8.5 in. by 13 in.)
  # 42 = ISO B4 (250 mm by 353 mm)
  # 43 = Japanese double postcard (200 mm by 148 mm)
  # 44 = Standard paper (9 in. by 11 in.)
  # 45 = Standard paper (10 in. by 11 in.)
  # 46 = Standard paper (15 in. by 11 in.)
  # 47 = Invite envelope (220 mm by 220 mm)
  # 50 = Letter extra paper (9.275 in. by 12 in.)
  # 51 = Legal extra paper (9.275 in. by 15 in.)
  # 52 = Tabloid extra paper (11.69 in. by 18 in.)
  # 53 = A4 extra paper (236 mm by 322 mm)
  # 54 = Letter transverse paper (8.275 in. by 11 in.)
  # 55 = A4 transverse paper (210 mm by 297 mm)
  # 56 = Letter extra transverse paper (9.275 in. by 12 in.)
  # 57 = SuperA/SuperA/A4 paper (227 mm by 356 mm)
  # 58 = SuperB/SuperB/A3 paper (305 mm by 487 mm)
  # 59 = Letter plus paper (8.5 in. by 12.69 in.)
  # 60 = A4 plus paper (210 mm by 330 mm)
  # 61 = A5 transverse paper (148 mm by 210 mm)
  # 62 = JIS B5 transverse paper (182 mm by 257 mm)
  # 63 = A3 extra paper (322 mm by 445 mm)
  # 64 = A5 extra paper (174 mm by 235 mm)
  # 65 = ISO B5 extra paper (201 mm by 276 mm)
  # 66 = A2 paper (420 mm by 594 mm)
  # 67 = A3 transverse paper (297 mm by 420 mm)
  # 68 = A3 extra transverse paper (322 mm by 445 mm)
  # 69 = Japanese Double Postcard (200 mm x 148 mm)
  # 70 = A6 (105 mm x 148 mm
  # 71 = Japanese Envelope Kaku #2
  # 72 = Japanese Envelope Kaku #3
  # 73 = Japanese Envelope Chou #3
  # 74 = Japanese Envelope Chou #4
  # 75 = Letter Rotated (11in x 8 1/2 11 in)
  # 76 = A3 Rotated (420 mm x 297 mm)
  # 77 = A4 Rotated (297 mm x 210 mm)
  # 78 = A5 Rotated (210 mm x 148 mm)
  # 79 = B4 (JIS) Rotated (364 mm x 257 mm)
  # 80 = B5 (JIS) Rotated (257 mm x 182 mm)
  # 81 = Japanese Postcard Rotated (148 mm x 100 mm)
  # 82 = Double Japanese Postcard Rotated (148 mm x 200 mm)
  # 83 = A6 Rotated (148 mm x 105 mm)
  # 84 = Japanese Envelope Kaku #2 Rotated
  # 85 = Japanese Envelope Kaku #3 Rotated
  # 86 = Japanese Envelope Chou #3 Rotated
  # 87 = Japanese Envelope Chou #4 Rotated
  # 88 = B6 (JIS) (128 mm x 182 mm)
  # 89 = B6 (JIS) Rotated (182 mm x 128 mm)
  # 90 = (12 in x 11 in)
  # 91 = Japanese Envelope You #4
  # 92 = Japanese Envelope You #4 Rotated
  # 93 = PRC 16K (146 mm x 215 mm)
  # 94 = PRC 32K (97 mm x 151 mm)
  # 95 = PRC 32K(Big) (97 mm x 151 mm)
  # 96 = PRC Envelope #1 (102 mm x 165 mm)
  # 97 = PRC Envelope #2 (102 mm x 176 mm)
  # 98 = PRC Envelope #3 (125 mm x 176 mm)
  # 99 = PRC Envelope #4 (110 mm x 208 mm)
  # 100 = PRC Envelope #5 (110 mm x 220 mm)
  # 101 = PRC Envelope #6 (120 mm x 230 mm)
  # 102 = PRC Envelope #7 (160 mm x 230 mm)
  # 103 = PRC Envelope #8 (120 mm x 309 mm)
  # 104 = PRC Envelope #9 (229 mm x 324 mm)
  # 105 = PRC Envelope #10 (324 mm x 458 mm)
  # 106 = PRC 16K Rotated
  # 107 = PRC 32K Rotated
  # 108 = PRC 32K(Big) Rotated
  # 109 = PRC Envelope #1 Rotated (165 mm x 102 mm)
  # 110 = PRC Envelope #2 Rotated (176 mm x 102 mm)
  # 111 = PRC Envelope #3 Rotated (176 mm x 125 mm)
  # 112 = PRC Envelope #4 Rotated (208 mm x 110 mm)
  # 113 = PRC Envelope #5 Rotated (220 mm x 110 mm)
  # 114 = PRC Envelope #6 Rotated (230 mm x 120 mm)
  # 115 = PRC Envelope #7 Rotated (230 mm x 160 mm)
  # 116 = PRC Envelope #8 Rotated (309 mm x 120 mm)
  # 117 = PRC Envelope #9 Rotated (324 mm x 229 mm)
  # 118 = PRC Envelope #10 Rotated (458 mm x 324 mm)
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:184
  def paper_size; end

  # Sets the paper size for printing.
  # @see PageSetup#paper_size
  # @return integer
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:189
  def paper_size=(size); end

  # Width of paper (string containing a number followed by a unit identifier: "210mm", "8.5in")
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:62
  def paper_width; end

  # @see paper_width
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:225
  def paper_width=(v); end

  # Print scaling (percent value, given as integer ranging from 10 to 400)
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:66
  def scale; end

  # @see scale
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:231
  def scale=(v); end

  # Set some or all page settings at once.
  # @param [Hash] options The page settings to set (possible keys are :fit_to_height, :fit_to_width, :orientation, :paper_height, :paper_width, and :scale).
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:196
  def set(options); end

  # Serializes the page settings element.
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/page_setup.rb:258
  def to_xml_string(str = T.unsafe(nil)); end
end

# Pane options for a worksheet.
#
# @note The recommended way to manage the pane options is via SheetView#pane
# @see SheetView#pane
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:8
class Axlsx::Pane
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new {Pane} object
  # @option options [Symbol] active_pane Active Pane
  # @option options [Symbol] state Split State
  # @option options [Cell, String] top_left_cell Top Left Visible Cell
  # @option options [Integer] x_split Horizontal Split Position
  # @option options [Integer] y_split Vertical Split Position
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:18
  def initialize(options = T.unsafe(nil)); end

  # Active Pane
  # The pane that is active.
  # Options are
  #  * bottom_left:  Bottom left pane, when both vertical and horizontal
  #                  splits are applied. This value is also used when only
  #                  a horizontal split has been applied, dividing the pane
  #                  into upper and lower regions. In that case, this value
  #                  specifies the bottom pane.
  #  * bottom_right: Bottom right pane, when both vertical and horizontal
  #                  splits are applied.
  #  * top_left:     Top left pane, when both vertical and horizontal splits
  #                  are applied. This value is also used when only a horizontal
  #                  split has been applied, dividing the pane into upper and lower
  #                  regions. In that case, this value specifies the top pane.
  #                  This value is also used when only a vertical split has
  #                  been applied, dividing the pane into right and left
  #                  regions. In that case, this value specifies the left pane
  #  * top_right:    Top right pane, when both vertical and horizontal
  #                  splits are applied. This value is also used when only
  #                  a vertical split has been applied, dividing the pane
  #                  into right and left regions. In that case, this value
  #                  specifies the right pane.
  # @see type
  # @return [Symbol]
  # default nil
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:52
  def active_pane; end

  # @see active_pane
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:99
  def active_pane=(v); end

  # Split State
  # Indicates whether the pane has horizontal / vertical
  # splits, and whether those splits are frozen.
  # Options are
  #  * frozen:       Panes are frozen, but were not split being frozen. In
  #                  this state, when the panes are unfrozen again, a single
  #                  pane results, with no split. In this state, the split
  #                  bars are not adjustable.
  #  * frozen_split: Panes are frozen and were split before being frozen. In
  #                  this state, when the panes are unfrozen again, the split
  #                  remains, but is adjustable.
  #  * split:        Panes are split, but not frozen. In this state, the split
  #                  bars are adjustable by the user.
  # @see type
  # @return [Symbol]
  # default nil
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:70
  def state; end

  # @see state
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:105
  def state=(v); end

  # Serializes the data validation
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:132
  def to_xml_string(str = T.unsafe(nil)); end

  # Top Left Visible Cell
  # Location of the top left visible cell in the bottom
  # right pane (when in Left-To-Right mode).
  # @see type
  # @return [String]
  # default nil
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:78
  def top_left_cell; end

  # @see top_left_cell
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:111
  def top_left_cell=(v); end

  # Horizontal Split Position
  # Horizontal position of the split, in 1/20th of a point; 0 (zero)
  # if none. If the pane is frozen, this value indicates the number
  # of columns visible in the top pane.
  # @see type
  # @return [Integer]
  # default 0
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:87
  def x_split; end

  # @see x_split
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:118
  def x_split=(v); end

  # Vertical Split Position
  # Vertical position of the split, in 1/20th of a point; 0 (zero)
  # if none. If the pane is frozen, this value indicates the number
  # of rows visible in the left pane.
  # @see type
  # @return [Integer]
  # default 0
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:96
  def y_split; end

  # @see y_split
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:124
  def y_split=(v); end

  private

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/pane.rb:139
  def finalize; end
end

# A PatternFill is the pattern and solid fill styling for a cell.
# @note The recommended way to manage styles is with Styles#add_style
# @see Style#add_style
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:7
class Axlsx::PatternFill
  include ::Axlsx::OptionsParser

  # Creates a new PatternFill Object
  # @option options [Symbol] patternType
  # @option options [Color] fgColor
  # @option options [Color] bgColor
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:14
  def initialize(options = T.unsafe(nil)); end

  # The color to use for the background of the fill when the type is not solid.
  # @return [Color]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:25
  def bgColor; end

  # @see bgColor
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:59
  def bgColor=(v); end

  # The color to use for the the background in solid fills.
  # @return [Color]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:21
  def fgColor; end

  # @see fgColor
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:53
  def fgColor=(v); end

  # The pattern type to use
  # @note
  #  patternType must be one of
  #   :none
  #   :solid
  #   :mediumGray
  #   :darkGray
  #   :lightGray
  #   :darkHorizontal
  #   :darkVertical
  #   :darkDown
  #   :darkUp
  #   :darkGrid
  #   :darkTrellis
  #   :lightHorizontal
  #   :lightVertical
  #   :lightDown
  #   :lightUp
  #   :lightGrid
  #   :lightTrellis
  #   :gray125
  #   :gray0625
  # @see Office Open XML Part 1 18.18.55
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:50
  def patternType; end

  # @see patternType
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:65
  def patternType=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/pattern_fill.rb:73
  def to_xml_string(str = T.unsafe(nil)); end
end

# a Pic object represents an image in your worksheet
# Worksheet#add_image is the recommended way to manage images in your sheets
# @see Worksheet#add_image
#
# pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:7
class Axlsx::Pic
  include ::Axlsx::OptionsParser

  # Creates a new Pic(ture) object
  # @param [Anchor] anchor the anchor that holds this image
  # @option options [Boolean] :remote indicates if image_src is a remote URI
  # @option options [String] :name
  # @option options [String] :descr
  # @option options [String] :image_src
  # @option options [Array] :start_at
  # @option options [Integer] :width
  # @option options [Integer] :height
  # @option options [Float] :opacity - set the picture opacity, accepts a value between 0.0 and 1.0
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:20
  def initialize(anchor, options = T.unsafe(nil)); end

  # The anchor for this image
  # @return [OneCellAnchor]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:50
  def anchor; end

  # A description of the picture
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:41
  def descr; end

  # @see descr
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:100
  def descr=(v); end

  # noop if not using a two cell anchor
  # @param [Integer] x The column
  # @param [Integer] y The row
  # @return [Marker]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:192
  def end_at(x, y = T.unsafe(nil)); end

  # returns the extension of image_src without the preceding '.'
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:123
  def extname; end

  # The file name of image_src without any path information
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:117
  def file_name; end

  # providing access to update the anchor's height attribute
  # @see OneCellAnchor.width
  # @note this is a noop if you are using a TwoCellAnchor
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:166
  def height; end

  # @see height
  # @note This is a noop if you are using a TwoCellAnchor
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:172
  def height=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:55
  def hyperlink; end

  # sets or updates a hyperlink for this image.
  # @param [String] v The href value for the hyper link
  # @option options @see Hyperlink#initialize All options available to the Hyperlink class apply - however href will be overridden with the v parameter value.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:68
  def hyperlink=(v, options = T.unsafe(nil)); end

  # The path to the image you want to include
  # Only local images are supported at this time.
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:46
  def image_src; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:80
  def image_src=(v); end

  # The index of this image in the workbooks images collections
  # @return [Index]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:129
  def index; end

  # The name to use for this picture
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:37
  def name; end

  # @see name
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:94
  def name=(v); end

  # Picture opacity
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:59
  def opacity; end

  # The picture locking attributes for this picture
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:53
  def picture_locking; end

  # The part name for this image used in serialization and relationship building
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:135
  def pn; end

  # The relationship object for this pic.
  # @return [Relationship]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:141
  def relationship; end

  # Flag for remote picture (from URI)
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:63
  def remote; end

  # @see remote
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:106
  def remote=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:111
  def remote?; end

  # This is a short cut method to set the start anchor position
  # If you need finer granularity in positioning use
  # graphic_frame.anchor.from.colOff / rowOff
  # @param [Integer] x The column
  # @param [Integer] y The row
  # @return [Marker]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:183
  def start_at(x, y = T.unsafe(nil)); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:201
  def to_xml_string(str = T.unsafe(nil)); end

  # providing access to the anchor's width attribute
  # @see OneCellAnchor.width
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:151
  def width; end

  # @see width
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:158
  def width=(v); end

  private

  # Return correct xml relationship string portion
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:223
  def relationship_xml_portion; end

  # refactoring of swapping code, law of demeter be damned!
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:248
  def swap_anchor(new_anchor); end

  # Changes the anchor to a one cell anchor.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:232
  def use_one_cell_anchor; end

  # changes the anchor type to a two cell anchor
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:240
  def use_two_cell_anchor; end
end

# allowed mime types
#
# pkg:gem/caxlsx#lib/axlsx/drawing/pic.rb:33
Axlsx::Pic::ALLOWED_MIME_TYPES = T.let(T.unsafe(nil), Array)

# The picture locking class defines the locking properties for pictures in your workbook.
#
# pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:5
class Axlsx::PictureLocking
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  include ::Axlsx::Accessors
  extend ::Axlsx::SerializedAttributes::ClassMethods
  extend ::Axlsx::Accessors::ClassMethods

  # Creates a new PictureLocking object
  # @option options [Boolean] noGrp
  # @option options [Boolean] noSelect
  # @option options [Boolean] noRot
  # @option options [Boolean] noChangeAspect
  # @option options [Boolean] noMove
  # @option options [Boolean] noResize
  # @option options [Boolean] noEditPoints
  # @option options [Boolean] noAdjustHandles
  # @option options [Boolean] noChangeArrowheads
  # @option options [Boolean] noChangeShapeType
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:29
  def initialize(options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noAdjustHandles; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noAdjustHandles=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noChangeArrowheads; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noChangeArrowheads=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noChangeAspect; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noChangeAspect=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noChangeShapeType; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noChangeShapeType=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noEditPoints; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noEditPoints=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noGrp; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noGrp=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noMove; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noMove=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noResize; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noResize=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noRot; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noRot=(value); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noSelect; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/picture_locking.rb:10
  def noSelect=(value); end

  # Serializes the object
