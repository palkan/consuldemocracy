# @note The recommended way to manage these rules is via Worksheet#add_conditional_formatting
# @see Worksheet#add_conditional_formatting
# @see ConditionalFormattingRule#initialize
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:10
class Axlsx::IconSet
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new icon set object
  # @option options [String] iconSet
  # @option options [Boolean] reverse
  # @option options [Boolean] percent
  # @option options [Boolean] showValue
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:19
  def initialize(options = T.unsafe(nil)); end

  # The icon set to display.
  # Allowed values are: 3Arrows, 3ArrowsGray, 3Flags, 3TrafficLights1, 3TrafficLights2, 3Signs, 3Symbols, 3Symbols2, 4Arrows, 4ArrowsGray, 4RedToBlack, 4Rating, 4TrafficLights, 5Arrows, 5ArrowsGray, 5Rating, 5Quarters
  # The default value is 3TrafficLights1
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:36
  def iconSet; end

  # @see iconSet
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:59
  def iconSet=(v); end

  # Sets the values of the interpolation points in the scale.
  # The default value is [0, 33, 67]
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:56
  def interpolationPoints; end

  # @see interpolationPoints
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:65
  def interpolationPoints=(v); end

  # Indicates whether the thresholds indicate percentile values, instead of number values.
  # The default value is true
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:41
  def percent; end

  # @see percent
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:78
  def percent=(v); end

  # If true, reverses the default order of the icons in this icon set.maxLength attribute
  # The default value is false
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:46
  def reverse; end

  # @see reverse
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:84
  def reverse=(v); end

  # Indicates whether to show the values of the cells on which this data bar is applied.
  # The default value is true
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:51
  def showValue; end

  # @see showValue
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:72
  def showValue=(v); end

  # Serialize this object to an xml string
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:92
  def to_xml_string(str = T.unsafe(nil)); end

  private

  # Initialize the simple typed list of value objects
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/icon_set.rb:103
  def initialize_value_objects; end
end

