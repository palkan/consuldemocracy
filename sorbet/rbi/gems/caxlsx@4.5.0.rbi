  # @option options [String] text The text for this comment
  # @option options [String|Cell] ref The cell that this comment is attached to.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:41
  def add_comment(options = T.unsafe(nil)); end

  # A sorted list of the unique authors in the contained comments
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:53
  def authors; end

  # The index of this collection in the workbook. Effectively the index of the worksheet.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:16
  def index; end

  # The part name for this object
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:22
  def pn; end

  # The relationships required by this object
  # @return [Array]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:59
  def relationships; end

  # serialize the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:67
  def to_xml_string(str = T.unsafe(nil)); end

  # the vml_drawing that holds the shapes for comments
  # @return [VmlDrawing]
  #
