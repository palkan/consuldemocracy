  def sz=(v); end

  # Serializes the cell
  # @param [Integer] r_index The row index for the cell
  # @param [Integer] c_index The cell index in the row.
  # @param [String] str The string index the cell content will be appended to. Defaults to empty string.
  # @return [String] xml text for the cell
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:409
  def to_xml_string(r_index, c_index, str = T.unsafe(nil)); end

  # The cell's data type.
  # Changing the type for a cell will recast the value into that type. If no type option is specified in the constructor, the type is
  # automatically determed.
  # @see Cell#cell_type_from_value
  # @return [Symbol] The type of data this cell's value is cast to.
  # @raise [ArgumentError] Cell.type must be one of [:date, time, :float, :integer, :string, :boolean]
  # @note
  #  If the value provided cannot be cast into the type specified, type is changed to :string and the following logic is applied.
  #   :string to :integer or :float, type conversions always return 0 or 0.0
  #   :string, :integer, or :float to :time conversions always return the original value as a string and set the cells type to :string.
  #  No support is currently implemented for parsing time strings.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:131
  def type; end

  # @see type
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:136
  def type=(v); end

  # The inline underline property for the cell.
  # It must be one of :none, :single, :double, :singleAccounting, :doubleAccounting
  # @return [Boolean]
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:306
  def u; end

  # @see u
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:309
  def u=(v); end

  # The value of this cell.
  # @return [String, Integer, Float, Time, Boolean] casted value based on cell's type attribute.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:159
  def value; end

  # @see value
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:162
  def value=(v); end

  # The inline vertical alignment property for the cell
  # this must be one of [:baseline, :subscript, :superscript]
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:335
  def vertAlign; end

  # @see vertAlign
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:338
  def vertAlign=(v); end

  private

  # Cast the value into this cells data type.
  # @note
  #   About Time - Time in OOXML is *different* from what you might expect. The history as to why is interesting, but you can safely assume that if you are generating docs on a mac, you will want to specify Workbook.1904 as true when using time typed values.
  # @see Axlsx#date1904
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:547
  def cast_value(v); end

  # Determines the cell type based on the cell value.
  # @note This is only used when a cell is created but no :type option is specified, the following rules apply:
  #   1. If the value is an instance of Date, the type is set to :date
  #   2. If the value is an instance of Time, the type is set to :time
  #   3. If the value is an instance of TrueClass or FalseClass, the type is set to :boolean
  #   4. :float and :integer types are determined by regular expression matching.
  #   5. Anything that does not meet either of the above is determined to be :string.
  # @return [Symbol] The determined type
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:523
  def cell_type_from_value(v); end

  # we scale the font size if bold style is applied to either the style font or
  # the cell itself. Yes, it is a bit of a hack, but it is much better than using
  # imagemagick and loading metrics for every character.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:493
  def font_size; end

  # Utility method for setting inline style attributes
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:501
  def set_run_style(validator, attr, value); end

  # @see ssti
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:510
  def ssti=(v); end

  # Returns the width of a string according to the current style
  # This is still not perfect...
  #  - scaling is not linear as font sizes increase
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:485
  def string_width(string, font_size); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:478
  def styles; end
end

# A regular expression to match the alpha(column)numeric(row) reference of a cell
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:76
Axlsx::Cell::CELL_REFERENCE_REGEX = T.let(T.unsafe(nil), Regexp)

# An array of valid cell types
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:72
Axlsx::Cell::CELL_TYPES = T.let(T.unsafe(nil), Array)

# An array of available inline styles.
# TODO change this to a hash where each key defines attr name and validator (and any info the validator requires)
# then move it out to a module so we can reuse in in other classes.
# needs to define bla=(v) and bla methods on the class that hook into a
# set_attr method that kicks the supplied validator and updates the instance_variable
# for the key
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell.rb:66
Axlsx::Cell::INLINE_STYLES = T.let(T.unsafe(nil), Array)

# CellAlignment stores information about the cell alignment of a style Xf Object.
# @note Using Styles#add_style is the recommended way to manage cell alignment.
# @see Styles#add_style
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:7
class Axlsx::CellAlignment
  include ::Axlsx::SerializedAttributes
  include ::Axlsx::OptionsParser
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Create a new cell_alignment object
  # @option options [Symbol] horizontal
  # @option options [Symbol] vertical
  # @option options [Integer] text_rotation
  # @option options [Boolean] wrap_text
  # @option options [Integer] indent
  # @option options [Integer] relative_indent
  # @option options [Boolean] justify_last_line
  # @option options [Boolean] shrink_to_fit
  # @option options [Integer] reading_order
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:22
  def initialize(options = T.unsafe(nil)); end

  # The horizontal alignment of the cell.
  # @note
  #  The horizontal cell alignment style must be one of
  #   :general
  #   :left
  #   :center
  #   :right
  #   :fill
  #   :justify
  #   :centerContinuous
  #   :distributed
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:38
  def horizontal; end

  # @see horizontal
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:89
  def horizontal=(v); end

  # The amount of indent
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:63
  def indent; end

  # @see indent
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:115
  def indent=(v); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:73
  def justifyLastLine; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:132
  def justifyLastLine=(v); end

  # Indicate if the last line should be justified.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:72
  def justify_last_line; end

  # @see justifyLastLine
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:128
  def justify_last_line=(v); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:86
  def readingOrder; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:146
  def readingOrder=(v); end

  # The reading order of the text
  # 0 Context Dependent
  # 1 Left-to-Right
  # 2 Right-to-Left
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:85
  def reading_order; end

  # @see readingOrder
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:142
  def reading_order=(v); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:68
  def relativeIndent; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:125
  def relativeIndent=(v); end

  # The amount of relativeIndent
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:67
  def relative_indent; end

  # @see relativeIndent
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:121
  def relative_indent=(v); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:78
  def shrinkToFit; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:139
  def shrinkToFit=(v); end

  # Indicate if the text should be shrunk to the fit in the cell.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:77
  def shrink_to_fit; end

  # @see shrinkToFit
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:135
  def shrink_to_fit=(v); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:54
  def textRotation; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:105
  def textRotation=(v); end

  # The textRotation of the cell.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:53
  def text_rotation; end

  # @see textRotation
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:101
  def text_rotation=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:151
  def to_xml_string(str = T.unsafe(nil)); end

  # The vertical alignment of the cell.
  # @note
  #  The vertical cell allingment style must be one of the following:
  #   :top
  #   :center
  #   :bottom
  #   :justify
  #   :distributed
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:49
  def vertical; end

  # @see vertical
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:95
  def vertical=(v); end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:59
  def wrapText; end

  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:112
  def wrapText=(v); end

  # Indicate if the text of the cell should wrap
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:58
  def wrap_text; end

  # @see wrapText
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_alignment.rb:108
  def wrap_text=(v); end
end

# CellProtection stores information about locking or hiding cells in spreadsheet.
# @note Using Styles#add_style is the recommended way to manage cell protection.
# @see Styles#add_style
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_protection.rb:7
class Axlsx::CellProtection
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new CellProtection
  # @option options [Boolean] hidden value for hidden protection
  # @option options [Boolean] locked value for locked protection
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_protection.rb:24
  def initialize(options = T.unsafe(nil)); end

  # specifies locking for cells that have the style containing this protection
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_protection.rb:15
  def hidden; end

  # @see hidden
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_protection.rb:29
  def hidden=(v); end

  # specifies if the cells that have the style containing this protection
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_protection.rb:19
  def locked; end

  # @see locked
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_protection.rb:35
  def locked=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_protection.rb:43
  def to_xml_string(str = T.unsafe(nil)); end
end

# The Cell Serializer class contains the logic for serializing cells based on their type.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:5
class Axlsx::CellSerializer
  class << self
    # Serializes cells that are type array formula
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:101
    def array_formula_serialization(cell, str = T.unsafe(nil)); end

    # Serializes cells that are type boolean
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:68
    def boolean(cell, str = T.unsafe(nil)); end

    # serializes cells that are type date
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:52
    def date(cell, str = T.unsafe(nil)); end

    # Serializes cells that are type float
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:76
    def float(cell, str = T.unsafe(nil)); end

    # Serializes cells that are type formula
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:92
    def formula_serialization(cell, str = T.unsafe(nil)); end

    # Serializes cells that are type inline_string
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:110
    def inline_string_serialization(cell, str = T.unsafe(nil)); end

    # Serializes cells that are type integer
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:84
    def integer(cell, str = T.unsafe(nil)); end

    # serializes cells that are type iso_8601
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:44
    def iso_8601(cell, str = T.unsafe(nil)); end

    # Serializes cells that are of the type richtext
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:136
    def richtext(cell, str); end

    # builds an xml text run based on this cells attributes.
    # @param [String] str The string instance this run will be concated to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:26
    def run_xml_string(cell, str = T.unsafe(nil)); end

    # Serializes cells that are type string
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:120
    def string(cell, str = T.unsafe(nil)); end

    # Serializes cells that are of the type text
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:148
    def text(cell, str); end

    # Serializes cells that are type time
    # @param [Cell] cell The cell that is being serialized
    # @param [String] str The string the serialized content will be appended to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:60
    def time(cell, str = T.unsafe(nil)); end

    # Calls the proper serialization method based on type.
    # @param [Integer] row_index The index of the cell's row
    # @param [Integer] column_index The index of the cell's column
    # @param [String] str The string to append serialization to.
    # @return [String]
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:12
    def to_xml_string(row_index, column_index, cell, str = T.unsafe(nil)); end

    private

    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:158
    def numeric(cell, str = T.unsafe(nil)); end

    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cell_serializer.rb:162
    def value_serialization(serialization_type, serialization_value, str = T.unsafe(nil)); end
  end
end

# CellStyle defines named styles that reference defined formatting records and can be used in your worksheet.
# @note Using Styles#add_style is the recommended way to manage cell styling.
# @see Styles#add_style
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:7
class Axlsx::CellStyle
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new CellStyle object
  # @option options [String] name
  # @option options [Integer] xfId
  # @option options [Integer] buildinId
  # @option options [Integer] iLevel
  # @option options [Boolean] hidden
  # @option options [Boolean] customBuiltIn
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:18
  def initialize(options = T.unsafe(nil)); end

  # The buildinId to use when this named style is applied
  # @return [Integer]
  # @see Axlsx::NumFmt
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:36
  def builtinId; end

  # @see builtinId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:63
  def builtinId=(v); end

  # Indicates that the build in style reference has been customized.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:48
  def customBuiltin; end

  # @see customBuiltin
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:81
  def customBuiltin=(v); end

  # Determines if this named style should show in the list of styles when using Excel
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:44
  def hidden; end

  # @see hidden
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:75
  def hidden=(v); end

  # Determines if this formatting is for an outline style, and what level of the outline it is to be applied to.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:40
  def iLevel; end

  # @see iLivel
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:69
  def iLevel=(v); end

  # The name of this cell style
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:26
  def name; end

  # @see name
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:51
  def name=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:89
  def to_xml_string(str = T.unsafe(nil)); end

  # The formatting record id this named style utilizes
  # @return [Integer]
  # @see Axlsx::Xf
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:31
  def xfId; end

  # @see xfId
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/cell_style.rb:57
  def xfId=(v); end
end

# Conditional Format Value Object
# Describes the values of the interpolation points in a gradient scale. This object is used by ColorScale, DataBar and IconSet classes
#
# @note The recommended way to manage these rules is via Worksheet#add_conditional_formatting
# @see Worksheet#add_conditional_formatting
# @see ConditionalFormattingRule#initialize
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:11
class Axlsx::Cfvo
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new Cfvo object
  # @option options [Symbol] type The type of conditional formatting value object
  # @option options [Boolean]  gte threshold value usage indicator
  # @option options [String] val The value of the conditional formatting object
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:19
  def initialize(options = T.unsafe(nil)); end

  # Type (xsd:boolean)
  # For icon sets, determines whether this threshold value uses the greater than or equal to operator. 0 indicates 'greater than' is used instead of 'greater than or equal to'.
  # The default value is true
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:35
  def gte; end

  # @see gte
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:49
  def gte=(v); end

  # serialize the Csvo object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:64
  def to_xml_string(str = T.unsafe(nil)); end

  # Type (ST_CfvoType)
  # The type of this conditional formatting value object. options are num, percent, max, min, formula and percentile
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:29
  def type; end

  # @see type
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:43
  def type=(v); end

  # Type (ST_Xstring)
  # The value of the conditional formatting object
  # This library will accept any value so long as it supports to_s
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:40
  def val; end

  # @see val
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvo.rb:55
  def val=(v); end
end

# A collection of Cfvo objects that initializes with the required
# first two items
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvos.rb:6
class Axlsx::Cfvos < ::Axlsx::SimpleTypedList
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvos.rb:7
  def initialize; end

  # Serialize the Cfvo object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cfvos.rb:14
  def to_xml_string(str = T.unsafe(nil)); end
end

# A Chart is the superclass for specific charts
# @note Worksheet#add_chart is the recommended way to create charts for your worksheets.
# @see README for examples
#
# pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:7
class Axlsx::Chart
  include ::Axlsx::OptionsParser

  # Creates a new chart object
  # @param [GraphicalFrame] frame The frame that holds this chart.
  # @option options [Cell, String] title
  # @option options [Boolean] show_legend
  # @option options [Symbol] legend_position
  # @option options [Array|String|Cell] start_at The X, Y coordinates defining the top left corner of the chart.
  # @option options [Array|String|Cell] end_at The X, Y coordinates defining the bottom right corner of the chart.
  # @option options [Boolean] plot_visible_only (true) Whether only data from visible cells should be plotted.
  # @option options [Boolean] rounded_corners (true) Whether the chart area shall have rounded corners.
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:19
  def initialize(frame, options = T.unsafe(nil)); end

  # Adds a new series to the chart's series collection.
  # @return [Series]
  # @see Series
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:199
  def add_series(options = T.unsafe(nil)); end

  # Background color for the chart
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:106
  def bg_color; end

  # Assigns a background color to chart area
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:205
  def bg_color=(v); end

  # TODO: data labels!
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:56
  def d_lbls; end

  # How to display blank values
  # Options are
  # * gap:  Display nothing
  # * span: Not sure what this does
  # * zero: Display as if the value were zero, not blank
  # @return [Symbol]
  # Default :gap (although this really should vary by chart type and grouping)
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:102
  def display_blanks_as; end

  # How to display blank values
  # @see display_blanks_as
  # @param [Symbol] v
  # @return [Symbol]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:165
  def display_blanks_as=(v); end

  # This is a short cut method to set the end anchor position
  # If you need finer granularity in positioning use
  # graphic_frame.anchor.to.colOff / rowOff
  # @param [Integer] x The column - default 10
  # @param [Integer] y The row - default 10
  # @return [Marker]
  # @see start_at
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:310
  def end_at(x = T.unsafe(nil), y = T.unsafe(nil)); end

  # backwards compatibility to allow chart.to and chart.from access to anchor markers
  # @note This will be disconinued in version 2.0.0. please use the start_at method
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:192
  def from; end

  # A reference to the graphic frame that owns this chart
  # @return [GraphicFrame]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:45
  def graphic_frame; end

  # The index of this chart in the workbooks charts collection
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:124
  def index; end

  # Set the location of the chart's legend
  # @return [Symbol] The position of this legend
  # @note
  #  The following are allowed
  #    :b
  #    :l
  #    :r
  #    :t
  #    :tr
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:93
  def legend_position; end

  # @see legend_position
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:179
  def legend_position=(v); end

  # Whether only data from visible cells should be plotted.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:110
  def plot_visible_only; end

  # Whether only data from visible cells should be plotted.
  # @param [Boolean] v
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:213
  def plot_visible_only=(v); end

  # The part name for this chart
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:130
  def pn; end

  # The relationship object for this chart.
  # @return [Relationship]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:118
  def relationship; end

  # Whether the chart area shall have rounded corners.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:114
  def rounded_corners; end

  # Whether the chart area shall have rounded corners.
  # @param [Boolean] v
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:221
  def rounded_corners=(v); end

  # A collection of series objects that are applied to the chart
  # @return [SimpleTypedList]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:49
  def series; end

  # The type of series to use for this chart.
  # @return [Series]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:53
  def series_type; end

  # Show the legend in the chart
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:82
  def show_legend; end

  # Show the legend in the chart
  # @param [Boolean] v
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:156
  def show_legend=(v); end

  # This is a short cut method to set the anchor start marker position
  # If you need finer granularity in positioning use
  #
  # This helper method acceps a fairly wide range of inputs exampled
  # below
  #
  # @example
  #
  #      start_at 0, 5 # The anchor start marker is set to 6th row of
  #      the first column
  #
  #      start_at [0, 5] # The anchor start marker is set to start on the 6th row
  #      of the first column
  #
  #      start_at "C1" # The anchor start marker is set to start on the first row
  #      of the third column
  #
  #      start_at sheet.rows.first.cells.last # The anchor start
  #      marker is set to the location of a specific cell.
  #
  # @param [Array|String|Cell] x the column, coordinates, string
  # reference or cell to use in setting the start marker position.
  # @param [Integer] y The row
  # @return [Marker]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:299
  def start_at(x = T.unsafe(nil), y = T.unsafe(nil)); end

  # The style for the chart.
  # see ECMA Part 1 §21.2.2.196
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:78
  def style; end

  # The style for the chart.
  # see ECMA Part 1 §21.2.2.196
  # @param [Integer] v must be between 1 and 48
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:173
  def style=(v); end

  # The title object for the chart.
  # @return [Title]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:73
  def title; end

  # The title object for the chart.
  # @param [String, Cell] v
  # @return [Title]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:137
  def title=(v); end

  # The size of the Title object of the chart.
  # @param [String] v The size for the title object
  # @see Title
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:149
  def title_size=(v); end

  # backwards compatibility to allow chart.to and chart.from access to anchor markers
  # @note This will be disconinued in version 2.0.0. Please use the end_at method
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:186
  def to; end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:229
  def to_xml_string(str = T.unsafe(nil)); end

  # Indicates that colors should be varied by datum
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:62
  def vary_colors; end

  # Configures the vary_colors options for this chart
  # @param [Boolean] v The value to set
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:66
  def vary_colors=(v); end

  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:41
  def view3D; end

  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:319
  def view3D=(v); end

  # The 3D view properties for the chart
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:40
  def view_3D; end

  # sets the view_3D object for the chart
  #
  # pkg:gem/caxlsx#lib/axlsx/drawing/chart.rb:315
  def view_3D=(v); end
end

# The Col class defines column attributes for columns in sheets.
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:5
class Axlsx::Col
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Create a new Col objects
  # @param min First column affected by this 'column info' record.
  # @param max Last column affected by this 'column info' record.
  # @option options [Boolean] collapsed see Col#collapsed
  # @option options [Boolean] hidden see Col#hidden
  # @option options [Boolean] outlineLevel see Col#outlineLevel
  # @option options [Boolean] phonetic see Col#phonetic
  # @option options [Integer] style see Col#style
  # @option options [Numeric] width see Col#width
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:22
  def initialize(min, max, options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:46
  def bestFit; end

  # Flag indicating if the specified column(s) is set to 'best fit'. 'Best fit' is set to true under these conditions:
  # The column width has never been manually set by the user, AND The column width is not the default width
  # 'Best fit' means that when numbers are typed into a cell contained in a 'best fit' column, the column width should
  #  automatically resize to display the number. [Note: In best fit cases, column width must not be made smaller, only larger. end note]
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:45
  def best_fit; end

  # Flag indicating if the outlining of the affected column(s) is in the collapsed state.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:50
  def collapsed; end

  # @see Col#collapsed
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:78
  def collapsed=(v); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:75
  def customWidth; end

  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:74
  def custom_width; end

  # Flag indicating if the affected column(s) are hidden on this worksheet.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:54
  def hidden; end

  # @see Col#hidden
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:84
  def hidden=(v); end

  # Last column affected by this 'column info' record.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:38
  def max; end

  # First column affected by this 'column info' record.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:34
  def min; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:59
  def outlineLevel; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:96
  def outlineLevel=(v); end

  # Outline level of affected column(s). Range is 0 to 7.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:58
  def outline_level; end

  # @see Col#outline
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:90
  def outline_level=(v); end

  # Flag indicating if the phonetic information should be displayed by default for the affected column(s) of the worksheet.
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:63
  def phonetic; end

  # @see Col#phonetic
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:99
  def phonetic=(v); end

  # Default style for the affected column(s). Affects cells not yet allocated in the column(s). In other words, this style applies to new columns.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:67
  def style; end

  # @see Col#style
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:105
  def style=(v); end

  # Serialize this columns data to an xml string
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:154
  def to_xml_string(str = T.unsafe(nil)); end

  # updates the width for this col based on the cells autowidth and
  # an optionally specified fixed width
  # @param [Cell] cell The cell to use in updating this col's width
  # @param [Numeric, :auto, :ignore, nil] fixed_width Decides how the width
  # of the cell should be updated. If this is specified as as Numeric the
  # width is set to this value and the cell's attributes are ignored. If set
  # to `nil` or `:auto` and `use_autowidth` is true, it uses the autowidth of
  # the cell. If set to `:ignore`, the cell's width is not changed. In any
  # case the col's width is set to the new value only if the current width is
  # smaller than the new one, so that the largest width of all cells in this
  # column is used.
  # @param [Boolean] use_autowidth If this is false, the cell's
  # autowidth value will be ignored.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:135
  def update_width(cell, fixed_width = T.unsafe(nil), use_autowidth = T.unsafe(nil)); end

  # The width of the column
  # @return [Numeric]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:71
  def width; end

  # @see Col#width
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:111
  def width=(v); end
end

# Maximum column width limit in MS Excel is 255 characters
# https://support.microsoft.com/en-us/office/excel-specifications-and-limits-1672b34d-7043-467e-8e27-269d656771c3
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col.rb:8
Axlsx::Col::MAX_WIDTH = T.let(T.unsafe(nil), Integer)

# A collection of Brake objects.
# Please do not use this class directly. Instead use
# Worksheet#add_break
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col_breaks.rb:7
class Axlsx::ColBreaks < ::Axlsx::SimpleTypedList
  # Instantiates a new list restricted to Break types
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col_breaks.rb:9
  def initialize; end

  # A column break specific helper for adding a break.
  # @param [Hash] options A list of options to pass into the Break object
  # The max and man options are fixed, however any other valid option for
  # Break will be passed to the created break object.
  # @see Break
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col_breaks.rb:18
  def add_break(options); end

  # Serialize the collection to xml
  # @param [String] str The string to append this lists xml to.
  # <colBreaks count="1" manualBreakCount="1">
  # <brk id="3" max="1048575" man="1"/>
  # </colBreaks>
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/col_breaks.rb:28
  def to_xml_string(str = T.unsafe(nil)); end
end

# The color class represents a color used for borders, fills an fonts
#
# pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:5
class Axlsx::Color
  include ::Axlsx::OptionsParser
  include ::Axlsx::SerializedAttributes
  extend ::Axlsx::SerializedAttributes::ClassMethods

  # Creates a new Color object
  # @option options [Boolean] auto
  # @option options [String] rgb
  # @option options [Float] tint
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:13
  def initialize(options = T.unsafe(nil)); end

  # Determines if the color is system color dependent
  # @return [Boolean]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:22
  def auto; end

  # @see auto
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:50
  def auto=(v); end

  # The color as defined in rgb terms.
  # @note
  #  rgb colors need to conform to ST_UnsignedIntHex. That basically means put 'FF' before you color
  # When assigning the rgb value the behavior is much like CSS selectors and can use shorthand versions as follows:
  # If you provide a two character value it will be repeated for each r, g, b assignment
  # If you provide data that is not 2 characters in length, and is less than 8 characters it will be padded with "F"
  # @example
  #        Color.new :rgb => "FF000000"
  #          => #<Axlsx::Color:0x102106b68 @rgb="FF000000">
  #        Color.new :rgb => "0A"
  #          => #<Axlsx::Color:0x102106b68 @rgb="FF0A0A0A">
  #        Color.new :rgb => "00BB"
  #          => #<Axlsx::Color:0x102106b68 @rgb="FFFF00BB">
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:38
  def rgb; end

  # @see color
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:56
  def rgb=(v); end

  # The tint value.
  # @note valid values are between -1.0 and 1.0
  # @return [Float]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:47
  def tint; end

  # @see tint
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:67
  def tint=(v); end

  # Serializes the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/stylesheet/color.rb:81
  def to_xml_string(str = T.unsafe(nil), tag_name = T.unsafe(nil)); end
end

# @note The recommended way to manage these rules is via Worksheet#add_conditional_formatting
# @see Worksheet#add_conditional_formatting
# @see ConditionalFormattingRule#initialize
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:10
class Axlsx::ColorScale
  # creates a new ColorScale object.
  # @see Cfvo
  # @see Color
  # @example
  #     color_scale = Axlsx::ColorScale.new({:type => :num, :val => 0.55, :color => 'fff7696c'})
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:58
  def initialize(*cfvos); end

  # adds a new cfvo / color pair to the color scale and returns a hash containing
  # a reference to the newly created cfvo and color objects so you can alter the default properties.
  # @return [Hash] a hash with :cfvo and :color keys referencing the newly added objects.
  # @param [Hash] options options for the new cfvo and color objects
  # @option [Symbol] type The type of cfvo you to add
  # @option [Any] val The value of the cfvo to add
  # @option [String] The rgb color for the cfvo
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:70
  def add(options = T.unsafe(nil)); end

  # A simple types list of colors
  # @return [SimpleTypedList]
  # @see Color
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:49
  def colors; end

  # removes the cfvo and color pair at the index specified.
  # @param [Integer] index The index of the cfvo and color object to delete
  # @note you cannot remove the first two cfvo and color pairs
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:79
  def delete_at(index = T.unsafe(nil)); end

  # Serialize this color_scale object data to an xml string
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:87
  def to_xml_string(str = T.unsafe(nil)); end

  # A simple typed list of cfvos
  # @return [SimpleTypedList]
  # @see Cfvo
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:42
  def value_objects; end

  private

  # There has got to be cleaner way of merging these arrays.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:97
  def initialize_default_cfvos(user_cfvos); end

  class << self
    # These are the default conditional formatting value objects
    # that define a two tone color gradient.
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:14
    def default_cfvos; end

    # A builder for three tone color gradient
    # @example
    #   #this creates a three tone color scale
    #   color_scale = Axlsx::ColorScale.three_tone
    # @see examples/example.rb conditional formatting examples.
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:33
    def three_tone; end

    # A builder for two tone color gradient
    # @example
    #   # this creates a two tone color scale
    #   color_scale = Axlsx::ColorScale.two_tone
    # @see examples/example.rb conditional formatting examples.
    #
    # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/color_scale.rb:24
    def two_tone; end
  end
end

# The cols class manages the col object used to manage column widths.
# This is where the magic happens with autowidth
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cols.rb:6
class Axlsx::Cols < ::Axlsx::SimpleTypedList
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cols.rb:7
  def initialize(worksheet); end

  # Serialize the Cols object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/cols.rb:17
  def to_xml_string(str = T.unsafe(nil)); end
end

# A comment is the text data for a comment
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:5
class Axlsx::Comment
  include ::Axlsx::OptionsParser
  include ::Axlsx::Accessors
  extend ::Axlsx::Accessors::ClassMethods

  # Creates a new comment object
  # @param [Comments] comments The comment collection this comment belongs to
  # @param [Hash] options
  # @option [String] author the author of the comment
  # @option [String] text The text for the comment
  # @option [String] ref The reference (e.g. 'A3' where this comment will be anchored.
  # @option [Boolean] visible This controls the visibility of the associated vml_shape.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:16
  def initialize(comments, options = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:25
  def author; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:25
  def author=(value); end

  # The index of this author in a unique sorted list of all authors in
  # the comment.
  # @return [Integer]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:50
  def author_index; end

  # The owning Comments object
  # @return [Comments]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:30
  def comments; end

  # The string based cell position reference (e.g. 'A1') that determines the positioning of this comment
  # @return [String|Cell]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:34
  def ref; end

  # @see ref
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:55
  def ref=(v); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:25
  def text; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:25
  def text=(value); end

  # serialize the object
  # @param [String] str
  # @return [String]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:64
  def to_xml_string(str = T.unsafe(nil)); end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:26
  def visible; end

  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:26
  def visible=(value); end

  # The vml shape that will render this comment
  # @return [VmlShape]
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:43
  def vml_shape; end

  private

  # initialize the vml shape based on this comment's ref/position in the worksheet.
  # by default, all columns are 5 columns wide and 5 rows high
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comment.rb:82
  def initialize_vml_shape; end
end

# Comments is a collection of Comment objects for a worksheet
#
# pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:5
class Axlsx::Comments < ::Axlsx::SimpleTypedList
  # Creates a new Comments object
  # @param [Worksheet] worksheet The sheet that these comments belong to.
  #
  # pkg:gem/caxlsx#lib/axlsx/workbook/worksheet/comments.rb:28
  def initialize(worksheet); end

  # Adds a new comment to the worksheet that owns these comments.
  # @note the author, text and ref options are required
